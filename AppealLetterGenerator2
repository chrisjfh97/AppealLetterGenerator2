    def _lookup_mapping_row(self, claim_user_group, contract_code):
        matches = [
            row for row in self.app_config.get("mapping_rows", [])
            if str(row.get("Claim User Group", "")).strip() == str(claim_user_group).strip()
            and str(row.get("Contract Code", "")).strip() == str(contract_code).strip()
        ]
        return matches[0] if matches else None

    def _find_acronym(self, claim_user_group):
        for row in self.app_config.get("acronym_rows", []):
