    def run_extract_notes(self):
        """Scans for letters, extracts text, and merges with Excel data."""
        self.q_print("Starting note extraction...")
        try:
            # --- 1. Get all base paths and settings ---
            folder_path = os.path.join(self.output_path, self.file_date_str)
            date = self.file_date_str
            acronym = self.client_acronym_str
            cm_head = self.heading_text_str
            separator = "."
            # --- 2. Find DOS column in the loaded DataFrame ---
            if "DOS" in self.df.columns:
                dos_col = "DOS"
            elif "Admission_Date" in self.df.columns:
                dos_col = "Admission_Date"
            elif "From_Date" in self.df.columns:
                dos_col = "From_Date"
            else:
                messagebox.showwarning(
                    "Missing Column",
                    "Could not find 'DOS', 'Admission_Date', or 'From_Date' column in the Excel file. The 'DOS' column in the output will be empty."
                )
                dos_col = None
            # --- 3. Build regex from config ---
            start_text = self.app_config["extract_config"].get(
                "start", DEFAULT_EXTRACT_START
            )
            end_text = self.app_config["extract_config"].get(
                "end", DEFAULT_EXTRACT_END
            )
            if end_text:
                pattern = rf"({re.escape(start_text)}.*?)(?={re.escape(end_text)})"
            else:
                pattern = rf"({re.escape(start_text)}.*)"
            self.q_print(f"Using regex pattern: {pattern}")
            # --- 4. Iterate through the DataFrame, not the folders ---
            extracted_data = []
            total_rows = len(self.df)
            processed_count = 0
            for index, row in self.df.iterrows():
                try:
                    account_number = str(row[self.account_col_name])
                except KeyError:
                    self.q_print(f" ERROR: Account column '{self.account_col_name}' not found. Skipping.")
                    continue
                self.q_print(
                    f"Processing account {index + 1}/{total_rows}: {account_number}"
                )
                dos_value = ""
                if dos_col:
                    try:
                        date_raw = row.get(dos_col, "")
                        dos_value = self.extract_first_dos_date(date_raw)
                    except Exception:
                        dos_value = ""
                # 1. Define the wildcard search pattern as you requested
                search_pattern = f"*{account_number}.docx"
                account_folder = os.path.join(folder_path, account_number)

                if not os.path.exists(account_folder):
                    self.q_print(f" WARNING: Folder not found at {account_folder}")
                    continue

                # 2. Use glob to find all matching files in that folder
                found_files = glob.glob(os.path.join(account_folder, search_pattern))

                # 3. Handle the results
                if not found_files:
                    self.q_print(
                        f" WARNING: No letter file found for account {account_number} (Pattern: {search_pattern})"
                    )
                    continue
                doc_path = found_files[0]  # Use the first file found
                doc_name_base = os.path.basename(doc_path).replace(".docx", "")

                if len(found_files) > 1:
                    self.q_print(
                        f" WARNING: Multiple files found for {account_number}. Using first one: {os.path.basename(doc_path)}"
                    )
                # --- 5. Perform Regex Extraction ---
                try:
                    doc = Document(doc_path)
                    letter_text = "\n".join([para.text for para in doc.paragraphs])
                    match = re.search(pattern, letter_text, re.DOTALL | re.IGNORECASE)
                    if match:
                        extracted_text = normalize_extracted_note_text(match.group(1))
                        heading_text = normalize_extracted_note_text(cm_head).rstrip(":")
                        body = (
                            heading_text
                            + ":\n"
                            + extracted_text
                            + "\nSaved as: "
                            + doc_name_base
                        )
                        extracted_data.append([
                            account_number,
                            body,
                            self.selected_ugid,
                            self.selected_smc_value,
                            self.selected_workflow,
                            dos_value,
                            "True" if self.facility_var.get() else "False",
                        ])
                        processed_count += 1
                        self.q_print(f" Extracted note for {account_number}")
                    else:
                        self.q_print(
                            f" WARNING: Pattern not found in {doc_name_base}"
                        )
                        continue
                except Exception as e:
                    self.q_print(f" ERROR processing file {doc_path}: {e}")
                    continue
            if not extracted_data:
                self.q_print("No notes were extracted.")
                messagebox.showinfo(
                    "Extraction Complete",
                    "Finished scanning, but no notes matching the pattern were extracted.",
                )
                return
            # --- 6. Save as XLSX file ---
            timestamp = dt.datetime.now().strftime("%m%d%y%H%M%S")
            xlsx_filename = f"Notes{timestamp}.xlsx"
            xlsx_file_path = os.path.join(folder_path, xlsx_filename)
            try:
                self.q_print(f"Saving to {xlsx_filename}...")
                df_notes = pd.DataFrame(extracted_data, columns=[
                    "Reference", "Note", "UGID", "Status Message", "Workflow Reason", "DOS", "Facility"
                ])
                df_notes.to_excel(xlsx_file_path, index=False, sheet_name="Notes")
                self._add_notes_table(xlsx_file_path)
                # --- 7. Store path and enable bot button ---
                self.last_notes_file_path = xlsx_file_path
                self.btn_send_to_bot.config(state=tk.NORMAL)
                self.q_print(
                    f"Successfully extracted {processed_count} notes to {xlsx_filename}"
                )
                messagebox.showinfo(
                    "Extraction Complete",
                    f"Successfully extracted {processed_count} notes.\n\n"
                    f"Saved to:\n{xlsx_file_path}\n\n"
                    "The 'Send Notes to Bot' button is now enabled."
                )
            except Exception as e:
                raise Exception(f"Error writing to XLSX file.\nError: {e}")
        except Exception as e:
            self.q_print(f"Error during note extraction: {e}")
            messagebox.showerror(
                "Extraction Failed",
                f"An error occurred during note extraction:\n{e}",
            )
        finally:
