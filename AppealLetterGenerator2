    def validate_template_fields(self, template_path):
        """Checks template fields against Excel columns using docxtpl."""
        self.q_print(f"Validating template: {os.path.basename(template_path)}...")
        if not os.path.exists(template_path):
            messagebox.showerror("Error", f"Template file not found:\n{template_path}")
            return {"__TEMPLATE_NOT_FOUND__"}
        try:
            doc = DocxTemplate(template_path)
            template_fields = (
                doc.get_undeclared_template_variables()
            )
            if self.df is None:
                messagebox.showerror(
                    "Error",
                    "Cannot validate template because Excel file is not loaded.",
                )
                return {"__EXCEL_NOT_LOADED__"}
            excel_cols = set(self.df.columns)
            allowed_non_excel_fields = {
                "TodayDate",
                "AddressBlock",
                "BlurbBlock",
                "SubjectBlock",
                "total_pages",
                "FileDate",
                "Patient_FirstName",
                "Patient_LastName",
            }
            allowed_non_excel_fields.update(
                self.app_config["fax_info"].keys()
            )
            allowed_non_excel_fields.update(
                ["payer_name", "payer_fax", "payer_attn"]
            )
            missing_fields = template_fields - excel_cols - allowed_non_excel_fields
            return missing_fields
        except Exception as e:
            self.q_print(
                f"Error validating template '{os.path.basename(template_path)}': {e}"
            )
            messagebox.showwarning(
                "Template Warning",
                f"Could not validate template {os.path.basename(template_path)}.\nError: {e}",
            )
            return set()

    def validate_blurb_placeholders(self, blurb_text, blurb_name):
        """Ensure blurb placeholders exist in the loaded Excel columns."""
        if not blurb_text:
            return set()
        if self.df is None:
            messagebox.showerror(
                "Blurb Validation Failed",
                "Cannot validate blurb placeholders because Excel is not loaded.",
            )
            return {"__EXCEL_NOT_LOADED__"}
        try:
            parsed = Environment().parse(blurb_text)
            placeholders = meta.find_undeclared_variables(parsed)
        except Exception as exc:
            messagebox.showerror(
                "Blurb Validation Failed",
                f"Unable to parse the blurb '{blurb_name}'.\n\nDetails: {exc}",
            )
            return {"__BLURB_PARSE_ERROR__"}
        allowed = set(self.df.columns)
        allowed.update({"Patient_FirstName", "Patient_LastName"})
        missing = placeholders - allowed
        if missing:
            messagebox.showerror(
                "Blurb Validation Failed",
                (
                    f"The blurb '{blurb_name}' contains placeholders that are not "
                    "available from the Excel file.\n\n"
                    f"Missing placeholders:\n• {', '.join(sorted(missing))}"
                ),
            )
        return missing
