                        continue
                    file_path = os.path.join(account_folder, file_name)
                    if file_name.endswith(".pdf"):
                        total_pages += get_pdf_page_count(file_path)
                    elif (
                        file_name.endswith(".docx")
                        and ".fax" not in file_name.lower()
                    ):
