    def run_clean_report(self):
        """Runs the provided pandas script to clean the detail report."""
        file_path = self.detail_report_path
        try:
            timestamp = dt.datetime.now().strftime("%d%m%Y_%H%M%S")
            self.q_print(f"Reading file: {os.path.basename(file_path)}...")
            data = pd.read_excel(
                file_path,
                skiprows=7,
                skipfooter=2,
                dtype={
                    "Client": str,
                    "Reference 1": str,
                    "Contract Code": str,
                    "Contract Name": str,
                    "Provider First Name": str,
                    "Provider Last Name": str,
                    "Provider TIN": str,
                    "Payor's Member ID": str,
                    "Patient First Name": str,
                    "Patient Last Name": str,
                    "Patient DOB": "datetime64[ns]",
                    "From Date": "datetime64[ns]",
                    "To Date": "datetime64[ns]",
                    "POS": str,
                    "CPT Code": str,
                    "Mod": str,
                    "Unit": int,
                    "Charge": "float64",
                    "Expected": "float64",
                    "Allowed": "float64",
                    "Variance": "float64",
                    "NPI": str,
                    "Line Item ICNs": str,
                },
            )
            self.q_print("Processing data...")
            data["From Date"] = pd.to_datetime(data["From Date"])
            data["To Date"] = pd.to_datetime(data["To Date"])
            def calc_DOS_range(dates):
                start_date = dates.min().strftime("%m/%d/%Y")
                end_date = dates.max().strftime("%m/%d/%Y")
                if start_date == end_date:
                    return start_date
                else:
                    return f"{start_date} - {end_date}"
            date_ranges = data.groupby("Reference 1").agg(
                {"From Date": lambda x: x.min(), "To Date": lambda x: x.max()}
            )
            date_ranges["DOS"] = date_ranges.apply(calc_DOS_range, axis=1)
            date_ranges = date_ranges.drop(["From Date", "To Date"], axis=1).reset_index()
            data = pd.merge(data, date_ranges, on="Reference 1")
            data = data[
                ~(
                    (data["Allowed"].isna())
                    | (data["Expected"].isna())
                    | (data["Expected"] == 0)
                    | (data["Variance"].isna())
                    | (data["Variance"] <= 0)
                )
            ]
            data["Mod"] = data["Mod"].apply(
                lambda x: x.replace(" ", ", ") if isinstance(x, str) else x
            )
            data["CPT Code"] = data.apply(
                lambda row: (
                    f"{row['CPT Code']} ({row['Mod']})"
                    if pd.notna(row["Mod"])
                    else row["CPT Code"]
                ),
                axis=1,
            )
            data["CPT_Count"] = data.groupby("Reference 1")["Reference 1"].transform("count")
            data["Procedure Count"] = data["CPT_Count"].apply(
                lambda x: "False" if x == 1 else "True"
            )
            data["Patient Name"] = (
                data["Patient First Name"]
                .str.cat(data["Patient Last Name"], sep=" ")
                .str.title()
            )
            data["Patient First Name"] = data["Patient First Name"].str.title()
            data["Patient Last Name"] = data["Patient Last Name"].str.title()
            credentials = set(
