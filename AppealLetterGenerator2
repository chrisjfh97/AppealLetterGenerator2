    def create_file_entry(
        self,
        parent,
        label_text,
        entry_text,
        command,
        row,
        col_offset=0,
        entry_width=50,
        span_columns=1,
    ):
        """Create a labeled entry with a browse button for selecting files."""

        label_column = col_offset
        entry_column = col_offset + 1
        button_column = entry_column + span_columns

        ttk.Label(parent, text=label_text).grid(
            row=row, column=label_column, padx=5, pady=5, sticky=tk.E
        )
        entry = ttk.Entry(parent, width=entry_width)
        entry.insert(0, entry_text)
        entry.grid(
            row=row,
            column=entry_column,
            columnspan=span_columns,
            padx=5,
            pady=5,
            sticky=tk.EW,
        )
        btn = ttk.Button(parent, text="Browse...", command=command)
        btn.grid(row=row, column=button_column, padx=5, pady=5)
        self.register_grid_weights(parent, {entry_column: 1})
        return entry
    def create_labeled_entry(self, parent, label_text, default_value, row):
        """Create a labeled entry widget pre-populated with a value."""
        ttk.Label(parent, text=label_text).grid(
            row=row, column=0, padx=5, pady=5, sticky=tk.E
        )
        entry = ttk.Entry(parent, width=40)
        entry.insert(0, default_value)
        entry.grid(row=row, column=1, padx=5, pady=5, sticky=tk.EW)
        self.register_grid_weights(parent, {1: 1})
        return entry
    def create_special_combo(self, parent, label_text, row):
