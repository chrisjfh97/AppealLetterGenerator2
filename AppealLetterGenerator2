    # --- build..._merge_dict ---
    def build_letter_merge_dict(self, row_data, blurb_text, blurb_subject):
        """Builds context for Letters/Forms, including processed Blurb."""
        final_blurb = ""
        if blurb_text:
            try:
                env = Environment()
                template = env.from_string(blurb_text)
                final_blurb = template.render(
                    row_data
                )
            except Exception as e:
                messagebox.showwarning(
                    "Blurb Warning", f"Error processing Blurb Jinja2 syntax: {e}"
                )
                final_blurb = f"[[ERROR PROCESSING BLURB: {e}]]\n{blurb_text}"
        full_data = {}
        full_data.update(row_data)
        full_data.update(self.user_info_data)
        full_data.update(self.selected_payer_data)
        full_data["AddressBlock"] = self.selected_address
        full_data["BlurbBlock"] = final_blurb
        full_data["SubjectBlock"] = blurb_subject
        full_data["TodayDate"] = self.today_date_str
        full_data["FileDate"] = self.file_date_str
        return full_data
    def build_fax_merge_dict(self, row_data, page_count):
        """Builds context for Faxes."""
        full_data = {}
        full_data.update(row_data)
        full_data.update(self.user_info_data)
        full_data.update(self.selected_payer_data)
        full_data["TodayDate"] = self.today_date_str
        full_data["FileDate"] = self.file_date_str
        full_data["total_pages"] = page_count
        return full_data
    # --- create_and_save_doc ---
    def create_and_save_doc(self, template_path, save_path_base, merge_data):
        """Uses docxtpl to render and save a .docx file."""
        try:
            doc = DocxTemplate(template_path)
            context = merge_data
            doc.render(context)
            docx_final_path = save_path_base + ".docx"
            doc.save(docx_final_path)
            return docx_final_path
        except Exception as e:
            error_msg = f"ERROR creating/rendering '{os.path.basename(save_path_base)}.docx' using template '{os.path.basename(template_path)}': {e}"
            self.q_print(error_msg)
            logging.error(error_msg, exc_info=True)
            import traceback
            traceback.print_exc()
            return None
