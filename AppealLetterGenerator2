    # --- UI helpers ---
    def _connect_signals(self):
        self.run_letters_btn.clicked.connect(self._run_letters)
        self.run_forms_btn.clicked.connect(self._run_forms)
        self.run_fax_btn.clicked.connect(self._run_fax)
        self.engine.progress_updated.connect(self._update_progress)
        self.engine.status_updated.connect(self._append_log)

    def _update_progress(self, value: int, label: str):
        self.progress_bar.setValue(value)
        self.status_label.setText(label)

    def _append_log(self, text: str):
        self.log_output.appendPlainText(text)

    def _load_config_into_ui(self):
        cfg = self.engine.state.app_config
        self.excel_path_edit.setText(cfg.get("excel_path", ""))
        self.letter_template_edit.setText(cfg.get("letter_template_path", ""))
        self.fax_template_edit.setText(cfg.get("fax_template_path", ""))
        self.output_path_edit.setText(cfg.get("output_path", ""))

        self._populate_combo(self.address_combo, cfg.get("addresses", {}))
        self._populate_combo(self.blurb_combo, cfg.get("blurbs", {}))
        self._populate_combo(self.form_combo, cfg.get("form_templates", {}))
        self._populate_combo(self.payer_combo, cfg.get("payer_contacts", {}))

        self._load_table_from_dict(self.address_table, cfg.get("addresses", {}))
        self._load_table_from_dict(self.blurb_table, cfg.get("blurbs", {}))
        self._load_table_from_dict(self.form_table, cfg.get("form_templates", {}))
        payer_data = cfg.get("payer_contacts", {})
        self.payer_table.setRowCount(0)
        for name, data in payer_data.items():
            row = self.payer_table.rowCount()
            self.payer_table.insertRow(row)
            self.payer_table.setItem(row, 0, QtWidgets.QTableWidgetItem(name))
            self.payer_table.setItem(row, 1, QtWidgets.QTableWidgetItem(data.get("payer_fax", "")))
            self.payer_table.setItem(row, 2, QtWidgets.QTableWidgetItem(data.get("payer_attn", "")))

        fax_info = cfg.get("fax_info", {})
        self.user_name_edit.setText(fax_info.get("user_name", ""))
        self.user_phone_edit.setText(fax_info.get("user_phone", ""))
        self.user_fax_edit.setText(fax_info.get("user_fax", ""))

        if cfg.get("excel_path") and Path(cfg.get("excel_path")).exists():
            try:
                self.engine.load_excel(cfg.get("excel_path"))
                self._refresh_column_config()
            except Exception as exc:
                self._append_log(f"Failed to reload Excel: {exc}")

    def _populate_combo(self, combo: QtWidgets.QComboBox, mapping: Dict[str, str]):
        combo.clear()
        combo.addItem("(None)", userData=None)
        for key in sorted(mapping.keys()):
            combo.addItem(key, userData=mapping[key])

    def _load_table_from_dict(self, table: QtWidgets.QTableWidget, mapping: Dict[str, str]):
        table.setRowCount(0)
        for key, value in mapping.items():
            row = table.rowCount()
            table.insertRow(row)
            table.setItem(row, 0, QtWidgets.QTableWidgetItem(key))
            table.setItem(row, 1, QtWidgets.QTableWidgetItem(value))

    def _remove_selected_rows(self, table: QtWidgets.QTableWidget):
        for index in sorted({i.row() for i in table.selectedIndexes()}, reverse=True):
            table.removeRow(index)
        self._persist_tab_data()

    def _add_address_row(self):
        row = self.address_table.rowCount()
        self.address_table.insertRow(row)
        self.address_table.setItem(row, 0, QtWidgets.QTableWidgetItem("New Address"))
        self.address_table.setItem(row, 1, QtWidgets.QTableWidgetItem(""))
        self._persist_tab_data()

    def _add_blurb_row(self):
        row = self.blurb_table.rowCount()
        self.blurb_table.insertRow(row)
        self.blurb_table.setItem(row, 0, QtWidgets.QTableWidgetItem("New Blurb"))
        self.blurb_table.setItem(row, 1, QtWidgets.QTableWidgetItem(""))
        self._persist_tab_data()

    def _add_form_row(self):
        row = self.form_table.rowCount()
        self.form_table.insertRow(row)
        self.form_table.setItem(row, 0, QtWidgets.QTableWidgetItem("New Form"))
        self.form_table.setItem(row, 1, QtWidgets.QTableWidgetItem(""))
        self._persist_tab_data()

    def _add_payer_row(self):
        row = self.payer_table.rowCount()
        self.payer_table.insertRow(row)
        self.payer_table.setItem(row, 0, QtWidgets.QTableWidgetItem("New Payer"))
        self.payer_table.setItem(row, 1, QtWidgets.QTableWidgetItem(""))
        self.payer_table.setItem(row, 2, QtWidgets.QTableWidgetItem(""))
        self._persist_tab_data()

    # --- Browsers ---
    def _browse_excel(self):
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Select Excel File", str(USER_PATHS.get("root", BASE_DIR)), "Excel Files (*.xlsx *.xls)")
        if not path:
            return
        self.excel_path_edit.setText(path)
        try:
            self.engine.load_excel(path)
            self._refresh_column_config()
            self._persist_tab_data()
            self._append_log(f"Loaded Excel file: {path}")
        except Exception as exc:
            QtWidgets.QMessageBox.critical(self, "Excel Error", str(exc))

    def _browse_letter_template(self):
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Select Letter Template", str(USER_PATHS.get("root", BASE_DIR)), "Word Templates (*.docx)")
        if path:
            self.letter_template_edit.setText(path)
            self._persist_tab_data()

    def _browse_fax_template(self):
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Select Fax Template", str(USER_PATHS.get("root", BASE_DIR)), "Word Templates (*.docx)")
        if path:
            self.fax_template_edit.setText(path)
            self._persist_tab_data()

    def _browse_form_template(self):
        if not self.form_table.currentRow() >= 0:
            QtWidgets.QMessageBox.information(self, "Select Row", "Please select a form entry to attach the template path.")
            return
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Select Form Template", str(USER_PATHS.get("root", BASE_DIR)), "Word Templates (*.docx)")
        if path:
            row = self.form_table.currentRow()
            self.form_table.setItem(row, 1, QtWidgets.QTableWidgetItem(path))
            self._persist_tab_data()

    def _browse_output(self):
        path = QtWidgets.QFileDialog.getExistingDirectory(self, "Select Output Folder", str(USER_PATHS.get("root", BASE_DIR)))
        if path:
            self.output_path_edit.setText(path)
            self._persist_tab_data()

    def _browse_detail(self):
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Select Detail Report", str(USER_PATHS.get("root", BASE_DIR)))
        if path:
            self.detail_path_edit.setText(path)

    # --- Data persistence from tabs ---
    def _persist_tab_data(self):
        current_address = self.address_combo.currentText()
        current_blurb = self.blurb_combo.currentText()
        current_form = self.form_combo.currentText()
        current_payer = self.payer_combo.currentText()

        cfg = self.engine.state.app_config
        cfg["excel_path"] = self.excel_path_edit.text()
        cfg["letter_template_path"] = self.letter_template_edit.text()
        cfg["fax_template_path"] = self.fax_template_edit.text()
        cfg["output_path"] = self.output_path_edit.text()

        cfg["fax_info"] = {
            "user_name": self.user_name_edit.text(),
            "user_phone": self.user_phone_edit.text(),
            "user_fax": self.user_fax_edit.text(),
        }

        cfg["addresses"] = self._table_to_dict(self.address_table)
        cfg["blurbs"] = self._table_to_dict(self.blurb_table)
        cfg["form_templates"] = self._table_to_dict(self.form_table)
        cfg["payer_contacts"] = self._payer_table_to_dict()

        cfg["column_formats"] = self.engine.state.app_config.get("column_formats", {})
        cfg.setdefault("special_cols", {})["account_col"] = self.account_column_combo.currentText()
        self.engine.save_config()
        self._populate_combo(self.address_combo, cfg.get("addresses", {}))
        self._populate_combo(self.blurb_combo, cfg.get("blurbs", {}))
        self._populate_combo(self.form_combo, cfg.get("form_templates", {}))
        self._populate_combo(self.payer_combo, cfg.get("payer_contacts", {}))
        self._restore_combo_selection(self.address_combo, current_address)
        self._restore_combo_selection(self.blurb_combo, current_blurb)
        self._restore_combo_selection(self.form_combo, current_form)
        self._restore_combo_selection(self.payer_combo, current_payer)

    def _restore_combo_selection(self, combo: QtWidgets.QComboBox, text: str):
        if not text:
            combo.setCurrentIndex(0)
            return
        index = combo.findText(text)
        if index >= 0:
            combo.setCurrentIndex(index)

    def _payer_table_to_dict(self) -> Dict[str, Dict[str, str]]:
        data: Dict[str, Dict[str, str]] = {}
        for row in range(self.payer_table.rowCount()):
            name_item = self.payer_table.item(row, 0)
            fax_item = self.payer_table.item(row, 1)
            attn_item = self.payer_table.item(row, 2)
            if name_item and name_item.text():
                data[name_item.text()] = {
                    "payer_fax": fax_item.text() if fax_item else "",
                    "payer_attn": attn_item.text() if attn_item else "",
                }
        return data

    def _table_to_dict(self, table: QtWidgets.QTableWidget) -> Dict[str, str]:
        data: Dict[str, str] = {}
        for row in range(table.rowCount()):
            key_item = table.item(row, 0)
            value_item = table.item(row, 1)
            if key_item and key_item.text():
                data[key_item.text()] = value_item.text() if value_item else ""
        return data

    # --- Column config ---
    def _refresh_column_config(self):
        df = self.engine.state.df
        if df is None:
            return
        formats = self.engine.state.app_config.get("column_formats", {})
        if not formats:
            formats = {col: "Text" for col in df.columns}
            self.engine.state.app_config["column_formats"] = formats
        self.format_table.setRowCount(0)
        self.account_column_combo.clear()
        for col in df.columns:
            self.account_column_combo.addItem(col)
            row = self.format_table.rowCount()
            self.format_table.insertRow(row)
            self.format_table.setItem(row, 0, QtWidgets.QTableWidgetItem(col))
            combo = QtWidgets.QComboBox()
            combo.addItems(["Text", "Date (YYYY-MM-DD)", "Date (MM/DD/YYYY)", "Monetary ($#,##.##)", "Percentage (##.##%)"])
            combo.setCurrentText(formats.get(col, "Text"))
            combo.currentTextChanged.connect(self._update_format_from_table)
            self.format_table.setCellWidget(row, 1, combo)
        account_col = self.engine.state.app_config.get("special_cols", {}).get("account_col", "")
        if account_col and account_col in df.columns:
            idx = self.account_column_combo.findText(account_col)
            if idx >= 0:
                self.account_column_combo.setCurrentIndex(idx)

    def _update_format_from_table(self):
        formats: Dict[str, str] = {}
        for row in range(self.format_table.rowCount()):
            col_item = self.format_table.item(row, 0)
            combo = self.format_table.cellWidget(row, 1)
            if col_item and combo:
                formats[col_item.text()] = combo.currentText()
        self.engine.state.app_config["column_formats"] = formats
        self._persist_tab_data()

    # --- Merge execution ---
    def _prepare_common_state(self) -> Optional[str]:
        self._persist_tab_data()
        cfg = self.engine.state.app_config
        self.engine.state.today_date_str = self.today_date_edit.date().toString("yyyy-MM-dd")
        self.engine.state.file_date_str = self.file_date_edit.text().strip()
        self.engine.state.client_acronym_str = self.client_acronym_edit.text().strip()
        self.engine.state.selected_address = self.address_combo.currentData() or ""
        self.engine.state.selected_blurb = self.blurb_combo.currentData() or ""
        payer_name = self.payer_combo.currentText()
        self.engine.state.selected_payer_data = cfg.get("payer_contacts", {}).get(payer_name, {})
        self.engine.state.user_info_data = cfg.get("fax_info", {})
        self.engine.state.account_col_name = self.account_column_combo.currentText()
        cfg.setdefault("special_cols", {})["account_col"] = self.engine.state.account_col_name
        self.engine.save_config()

        if self.engine.state.df is None:
            return "Please load an Excel file first."
        if not self.output_path_edit.text():
            return "Please choose an output folder."
        return None

    def _run_letters(self):
        error = self._prepare_common_state()
        if error:
            QtWidgets.QMessageBox.warning(self, "Missing Info", error)
            return
        template = self.letter_template_edit.text()
        if not template:
            QtWidgets.QMessageBox.warning(self, "Missing Template", "Please select a letter template.")
            return
        missing = self.engine.validate_template_fields(template)
        if missing:
            QtWidgets.QMessageBox.critical(self, "Template Missing Fields", f"Template is missing: {', '.join(sorted(missing))}")
            return
        tasks = self.engine.build_letter_tasks()
        success, errors = self.engine.run_merge(tasks, template, self.output_path_edit.text(), "Letters")
        self._append_log(f"Letter generation complete. Success: {success}, Errors: {len(errors)}")
        if errors:
            QtWidgets.QMessageBox.warning(self, "Letters Completed with Issues", "Some letters could not be created. See log for details.")

    def _run_forms(self):
        error = self._prepare_common_state()
        if error:
            QtWidgets.QMessageBox.warning(self, "Missing Info", error)
            return
        form_name = self.form_combo.currentText()
        template = self.engine.state.app_config.get("form_templates", {}).get(form_name, "")
        if not template:
            QtWidgets.QMessageBox.warning(self, "Missing Template", "Please select a form template.")
            return
        missing = self.engine.validate_template_fields(template)
        if missing:
            QtWidgets.QMessageBox.critical(self, "Template Missing Fields", f"Template is missing: {', '.join(sorted(missing))}")
            return
        tasks = self.engine.build_form_tasks()
        success, errors = self.engine.run_merge(tasks, template, self.output_path_edit.text(), "Forms")
        self._append_log(f"Form generation complete. Success: {success}, Errors: {len(errors)}")
        if errors:
            QtWidgets.QMessageBox.warning(self, "Forms Completed with Issues", "Some forms could not be created. See log for details.")

    def _run_fax(self):
        error = self._prepare_common_state()
        if error:
            QtWidgets.QMessageBox.warning(self, "Missing Info", error)
            return
        template = self.fax_template_edit.text()
        if not template:
            QtWidgets.QMessageBox.warning(self, "Missing Template", "Please select a fax template.")
            return
        missing = self.engine.validate_template_fields(template)
        if missing:
            QtWidgets.QMessageBox.critical(self, "Template Missing Fields", f"Template is missing: {', '.join(sorted(missing))}")
            return
        page_count = 1
        tasks = self.engine.build_fax_tasks(page_count)
        success, errors = self.engine.run_merge(tasks, template, self.output_path_edit.text(), "Faxes")
        self._append_log(f"Fax generation complete. Success: {success}, Errors: {len(errors)}")
        if errors:
            QtWidgets.QMessageBox.warning(self, "Faxes Completed with Issues", "Some faxes could not be created. See log for details.")


def main():
    logging.basicConfig(
        filename=DEBUG_LOG_PATH,
        filemode="w",
        level=logging.DEBUG,
        format="%(asctime)s - %(levelname)s - %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )
    app = QtWidgets.QApplication(sys.argv)
    window = MergeApp()
    window.show()
    try:
        sys.exit(app.exec())
    except Exception as exc:  # pragma: no cover
        logging.error("Fatal GUI error: %s", exc, exc_info=True)
        with open(CRASH_LOG_PATH, "a", encoding="utf-8") as f:
            import traceback

            f.write(f"\n--- {datetime.now()} ---\n")
            f.write(traceback.format_exc())


if __name__ == "__main__":
    main()
