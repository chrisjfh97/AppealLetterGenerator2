# --- Helpers ---
def clean_column_name(col_name: str) -> str:
    return col_name.strip().replace(" ", "_").replace("-", "_")


def format_value(value, format_type: str):
    try:
        if format_type == "Date (YYYY-MM-DD)":
            return pd.to_datetime(value).strftime("%Y-%m-%d")
        if format_type == "Date (MM/DD/YYYY)":
            return pd.to_datetime(value).strftime("%m/%d/%Y")
        if format_type == "Monetary ($#,##.##)":
            return f"${float(value):,.2f}"
        if format_type == "Percentage (##.##%)":
            return f"{float(value):.2f}%"
    except ValueError:
        logging.warning("Warning: Could not apply format '%s' to value '%s'. Using raw string.", format_type, value)
    except Exception as exc:  # pragma: no cover - defensive
        logging.warning("Warning: Unexpected error formatting value '%s' with format '%s': %s", value, format_type, exc)
    return "" if pd.isna(value) else str(value)


class FormattedValue:
    """Wrap a raw value while deferring formatting until string coercion."""

    def __init__(self, raw, formatter):
        self.raw = raw
        self._formatter = formatter

    def __str__(self):
        return self._formatter(self.raw)

    def __repr__(self):
        return f"FormattedValue(raw={self.raw!r}, formatted={str(self)!r})"

    def __float__(self):
        try:
            return float(self.raw)
        except Exception:
            return float("nan")

    def __int__(self):
        try:
            return int(float(self.raw))
        except Exception:
            return 0

    def __bool__(self):
        if pd.isna(self.raw):
            return False
        return bool(self.raw)

    def _coerce_other(self, other):
        return other.raw if isinstance(other, FormattedValue) else other

    def __eq__(self, other):
        return self.raw == self._coerce_other(other)

    def __lt__(self, other):
        return self.raw < self._coerce_other(other)

    def __le__(self, other):
        return self.raw <= self._coerce_other(other)

    def __gt__(self, other):
        return self.raw > self._coerce_other(other)

    def __ge__(self, other):
        return self.raw >= self._coerce_other(other)


def build_formatted_row(row: pd.Series, column_formats: Dict[str, str]):
    data_dict = row.to_dict()
    formatted_dict = {}
    for col, val in data_dict.items():
        format_type = column_formats.get(col, "Text")
        formatted_dict[col] = FormattedValue(val, lambda raw_val, fmt=format_type: format_value(raw_val, fmt))

    patient_name_col_key = "Patient_Name"
    first_name_placeholder = "Patient_FirstName"
    last_name_placeholder = "Patient_LastName"

    patient_value = data_dict.get(patient_name_col_key, "")
    patient_full_name = "" if pd.isna(patient_value) else str(patient_value)

    if patient_full_name and "," in patient_full_name:
        try:
            parts = patient_full_name.split(",", 1)
            formatted_dict[last_name_placeholder] = parts[0].strip()
            formatted_dict[first_name_placeholder] = parts[1].strip()
        except Exception:
            formatted_dict[last_name_placeholder] = patient_full_name
            formatted_dict[first_name_placeholder] = ""
    else:
        formatted_dict[last_name_placeholder] = patient_full_name.strip()
        formatted_dict[first_name_placeholder] = ""

    return formatted_dict


def get_docx_page_count(docx_fpath):
    try:
        import zipfile

        with zipfile.ZipFile(docx_fpath) as docx_object:
            docx_property_file_data = docx_object.read("docProps/app.xml").decode()
            match = re.search(r"<Pages>(\d+)</Pages>", docx_property_file_data)
            if match:
                return int(match.group(1))
            match = re.search(r"<Words>(\d+)</Words>", docx_property_file_data)
            if match and int(match.group(1)) > 0:
                return 1
            return 0
    except Exception as e:  # pragma: no cover - defensive
        logging.error("Error counting DOCX pages for %s: %s", docx_fpath, e, exc_info=True)
        return 0


def get_pdf_page_count(pdf_fpath):
    try:
        with fitz.open(pdf_fpath) as doc:
            return len(doc)
    except Exception as e:  # pragma: no cover - defensive
        logging.error("Error counting PDF pages for %s: %s", pdf_fpath, e, exc_info=True)
        return 0


@dataclass
class MergeTask:
    account_number: str
    file_basename: str
    context: Dict[str, object]


@dataclass
class AppState:
    df: Optional[pd.DataFrame] = None
    app_config: Dict[str, object] = field(default_factory=dict)
    column_formats: Dict[str, str] = field(default_factory=dict)
    account_col_name: str = ""
    selected_address: str = ""
    selected_blurb: str = ""
    selected_payer_data: Dict[str, str] = field(default_factory=dict)
    user_info_data: Dict[str, str] = field(default_factory=dict)
    today_date_str: str = ""
    file_date_str: str = ""
    client_acronym_str: str = ""


class MergeEngine(QtCore.QObject):
    status_updated = QtCore.pyqtSignal(str)
    progress_updated = QtCore.pyqtSignal(int, str)

    def __init__(self):
        super().__init__()
        self.state = AppState()
        self.state.app_config = {
            "excel_path": "",
            "letter_template_path": "",
            "fax_template_path": "",
            "form_templates": {},
            "payer_contacts": {},
            "output_path": "",
            "column_formats": {},
            "addresses": {},
            "blurbs": {},
            "fax_info": {
                "user_name": "",
                "user_phone": "",
                "user_fax": "",
            },
            "special_cols": {"account_col": ""},
            "supporting_doc_path": "",
            "supporting_doc_suffix": "addinfo",
            "extract_config": {"start": "According", "end": "correct allowed amount."},
            "user_notes": "",
            "cm_headings": {},
        }
        self.load_config()

    # --- Configuration ---
    def load_config(self):
        try:
            if CONFIG_FILE_PATH.exists():
                loaded_config = json.loads(CONFIG_FILE_PATH.read_text(encoding="utf-8"))

                def deep_update(source, overrides):
                    for key, value in overrides.items():
                        if isinstance(value, dict) and key in source and isinstance(source[key], dict):
                            deep_update(source[key], value)
                        else:
                            source[key] = value
                    return source

                self.state.app_config = deep_update(self.state.app_config, loaded_config)
        except Exception as exc:  # pragma: no cover - defensive
            logging.error("Error loading config: %s", exc, exc_info=True)

    def save_config(self):
        try:
            CONFIG_FILE_PATH.parent.mkdir(parents=True, exist_ok=True)
            CONFIG_FILE_PATH.write_text(json.dumps(self.state.app_config, indent=4), encoding="utf-8")
        except Exception as exc:  # pragma: no cover - defensive
            logging.error("Error saving config: %s", exc, exc_info=True)

    # --- Data loading ---
    def load_excel(self, filepath: str) -> pd.DataFrame:
        self.state.df = pd.read_excel(filepath)
        self.state.df.columns = [clean_column_name(col) for col in self.state.df.columns]
        if not self.state.app_config.get("column_formats"):
            self.state.app_config["column_formats"] = {col: "Text" for col in self.state.df.columns}
        self.state.column_formats = self.state.app_config["column_formats"]
        self.state.account_col_name = self.state.app_config.get("special_cols", {}).get("account_col", "")
        self.state.app_config["excel_path"] = filepath
        self.save_config()
        return self.state.df

    # --- Templating helpers ---
    def build_letter_merge_dict(self, row_data: Dict[str, object], blurb_text: str) -> Dict[str, object]:
        final_blurb = ""
        if blurb_text:
            try:
                env = Environment()
                final_blurb = env.from_string(blurb_text).render(row_data)
            except Exception as exc:
                logging.warning("Error processing blurb template: %s", exc)
                final_blurb = f"[[ERROR PROCESSING BLURB: {exc}]]\n{blurb_text}"
        full_data = {}
        full_data.update(row_data)
        full_data.update(self.state.user_info_data)
        full_data.update(self.state.selected_payer_data)
        full_data["AddressBlock"] = self.state.selected_address
        full_data["BlurbBlock"] = final_blurb
        full_data["TodayDate"] = self.state.today_date_str
        full_data["FileDate"] = self.state.file_date_str
        return full_data

    def build_fax_merge_dict(self, row_data: Dict[str, object], page_count: int) -> Dict[str, object]:
        full_data = {}
        full_data.update(row_data)
        full_data.update(self.state.user_info_data)
        full_data.update(self.state.selected_payer_data)
        full_data["TodayDate"] = self.state.today_date_str
        full_data["FileDate"] = self.state.file_date_str
        full_data["total_pages"] = page_count
        return full_data

    def format_row_data(self, row: pd.Series):
        return build_formatted_row(row, self.state.app_config.get("column_formats", {}))

    # --- Task builders ---
    def build_letter_tasks(self) -> List[MergeTask]:
        tasks: List[MergeTask] = []
        if self.state.df is None:
            return tasks
        total_rows = len(self.state.df)
        for index, row in self.state.df.iterrows():
            account_number = str(row[self.state.account_col_name]) if self.state.account_col_name else str(index + 1)
            file_basename = f"{self.state.file_date_str}.{self.state.client_acronym_str}.{account_number}"
            merge_data = self.format_row_data(row)
            full_merge_data = self.build_letter_merge_dict(merge_data, self.state.selected_blurb)
            tasks.append(MergeTask(account_number, file_basename, full_merge_data))
            self.progress_updated.emit(int((index + 1) / total_rows * 25), "Preparing letter contexts")
        return tasks

    def build_form_tasks(self) -> List[MergeTask]:
        tasks: List[MergeTask] = []
        if self.state.df is None:
            return tasks
        total_rows = len(self.state.df)
        for index, row in self.state.df.iterrows():
            account_number = str(row[self.state.account_col_name]) if self.state.account_col_name else str(index + 1)
            file_basename = f"{self.state.file_date_str}.{self.state.client_acronym_str}.{account_number}"
            merge_data = self.format_row_data(row)
            full_merge_data = self.build_letter_merge_dict(merge_data, self.state.selected_blurb)
            tasks.append(MergeTask(account_number, file_basename, full_merge_data))
            self.progress_updated.emit(int((index + 1) / total_rows * 25), "Preparing form contexts")
        return tasks

    def build_fax_tasks(self, page_count: int) -> List[MergeTask]:
        tasks: List[MergeTask] = []
        if self.state.df is None:
            return tasks
        total_rows = len(self.state.df)
        for index, row in self.state.df.iterrows():
            account_number = str(row[self.state.account_col_name]) if self.state.account_col_name else str(index + 1)
            file_basename = f"{self.state.file_date_str}.{self.state.client_acronym_str}.{account_number}"
            merge_data = self.format_row_data(row)
            full_merge_data = self.build_fax_merge_dict(merge_data, page_count)
            tasks.append(MergeTask(account_number, file_basename, full_merge_data))
            self.progress_updated.emit(int((index + 1) / total_rows * 25), "Preparing fax contexts")
        return tasks

    # --- Merge operations ---
    def create_and_save_doc(self, template_path: str, save_path_base: str, merge_data: Dict[str, object]) -> Optional[str]:
        try:
            doc = DocxTemplate(template_path)
            doc.render(merge_data)
            docx_final_path = save_path_base + ".docx"
            Path(docx_final_path).parent.mkdir(parents=True, exist_ok=True)
            doc.save(docx_final_path)
            return docx_final_path
        except Exception as exc:
            logging.error("Failed to render document %s: %s", save_path_base, exc, exc_info=True)
            return None

    def _write_error_log(self, message: str):
        try:
            with open(ERROR_LOG_PATH, "a", encoding="utf-8") as f:
                f.write(f"[{datetime.now()}] {message}\n")
        except Exception:  # pragma: no cover
            logging.error("Could not write error log entry")

    def run_merge(self, tasks: List[MergeTask], template_path: str, output_root: str, label: str) -> Tuple[int, List[str]]:
        success = 0
        errors: List[str] = []
        if not tasks:
            return success, ["No tasks to process"]

        for index, task in enumerate(tasks):
            day_folder = os.path.join(output_root, self.state.file_date_str)
            account_folder = os.path.join(day_folder, task.account_number)
            os.makedirs(account_folder, exist_ok=True)
            save_path_base = os.path.join(account_folder, task.file_basename)
            output_path = self.create_and_save_doc(template_path, save_path_base, task.context)
            if output_path:
                success += 1
            else:
                errors.append(task.account_number)
                self._write_error_log(f"{label} failed for {task.account_number}")
            self.progress_updated.emit(int(((index + 1) / len(tasks)) * 100), f"{label}: {index + 1}/{len(tasks)}")
        return success, errors

    # --- Template validation ---
    def validate_template_fields(self, template_path: str) -> set:
        missing_fields = set()
        try:
            doc = DocxTemplate(template_path)
            template_fields = doc.get_undeclared_template_variables()
            if self.state.df is None:
                return {"__EXCEL_NOT_LOADED__"}
            excel_cols = set(self.state.df.columns)
            allowed = {"TodayDate", "AddressBlock", "BlurbBlock", "total_pages", "FileDate", "Patient_FirstName", "Patient_LastName"}
            allowed.update(self.state.app_config.get("fax_info", {}).keys())
            allowed.update(["payer_name", "payer_fax", "payer_attn"])
            missing_fields = template_fields - excel_cols - allowed
        except Exception as exc:  # pragma: no cover
            logging.warning("Template validation failed for %s: %s", template_path, exc)
        return missing_fields


