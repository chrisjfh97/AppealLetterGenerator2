    def _create_sample_document(self, label, template_path, merge_data):
        """Create a temporary document and open it immediately without persisting folders."""

        try:
            temp_file = tempfile.NamedTemporaryFile(
                prefix=f"appeal_sample_{label}_", delete=False
            )
            temp_base = Path(temp_file.name)
            temp_file.close()

            output_path = self.create_and_save_doc(
                template_path, str(temp_base), merge_data
            )
            temp_base.unlink(missing_ok=True)

            if not output_path:
                raise Exception("Failed to create the sample document.")

            self.q_print(f"Sample {label} created and opening: {output_path}")
            self._open_path(output_path)
            self._schedule_temp_cleanup(output_path)
        except Exception as exc:
            logging.error("Sample %s generation failed: %s", label, exc, exc_info=True)
            messagebox.showerror(
                "Sample Generation Failed",
                f"Unable to create sample {label}:\n{exc}",
            )

    def _schedule_temp_cleanup(self, output_path, delay_seconds=900):
        """Remove a temporary file after a delay to avoid cluttering temp directories."""

        def _cleanup():
            try:
                Path(output_path).unlink(missing_ok=True)
            except Exception as exc:  # pragma: no cover - best-effort cleanup
                logging.debug("Failed to cleanup temp sample file %s: %s", output_path, exc)

        timer = threading.Timer(delay_seconds, _cleanup)
        timer.daemon = True
        timer.start()

    def _open_path(self, output_path):
        """Open a filesystem path using the platform default handler."""

        try:
            if sys.platform.startswith("win"):
                os.startfile(output_path)
            elif sys.platform == "darwin":
                subprocess.Popen(["open", output_path])
            else:
                subprocess.Popen(["xdg-open", output_path])
        except Exception as exc:
            raise RuntimeError(f"Failed to open path '{output_path}': {exc}")

