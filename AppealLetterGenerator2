                subject = DEFAULT_BLURB_SUBJECT
            normalized[key] = {"body": body, "subject": subject}
        self.app_config["blurbs"] = normalized

    def normalize_template_config(self):
        """Ensure templates are grouped by type and migrate legacy settings."""
        templates = self.app_config.get("templates")
        if not isinstance(templates, dict):
            templates = {}
        for template_type in ("letter", "fax", "form"):
            if not isinstance(templates.get(template_type), dict):
                templates[template_type] = {}

        form_templates = self.app_config.get("form_templates")
        if isinstance(form_templates, dict):
            for name, path in form_templates.items():
                templates["form"].setdefault(name, path)

        selected_templates = self.app_config.get("selected_templates")
        if not isinstance(selected_templates, dict):
            selected_templates = {"letter": "", "fax": "", "form": ""}

        def add_template_from_path(template_type, template_path):
            if not template_path:
                return ""
            existing_name = next(
                (
                    name
                    for name, path in templates[template_type].items()
                    if path == template_path
                ),
                "",
            )
            if existing_name:
                return existing_name
            base_name = Path(template_path).stem
            name = self.ensure_unique_template_name(base_name, templates[template_type])
            templates[template_type][name] = template_path
            return name

        letter_selected = add_template_from_path(
            "letter", self.app_config.get("letter_template_path", "")
        )
        fax_selected = add_template_from_path(
            "fax", self.app_config.get("fax_template_path", "")
        )
        if letter_selected and not selected_templates.get("letter"):
            selected_templates["letter"] = letter_selected
        if fax_selected and not selected_templates.get("fax"):
            selected_templates["fax"] = fax_selected
        if not selected_templates.get("form") and len(templates["form"]) == 1:
            selected_templates["form"] = next(iter(templates["form"].keys()))

        self.app_config["templates"] = templates
        self.app_config["selected_templates"] = selected_templates
        self.app_config["form_templates"] = templates["form"]

