    def handle_clean_special_chars(self):
        warning_message = (
            "This will rename files in the output folder by removing special characters.\n"
            "Are you sure you want to proceed?"
        )
        if not ask_yes_no(self, "Warning", warning_message):
            return
        try:
            output_dir = Path(self.entry_output.text().strip())
            for file_path in output_dir.glob("**/*"):
                if file_path.is_file():
                    cleaned_name = re.sub(r"[^A-Za-z0-9._-]", "", file_path.name)
                    if cleaned_name != file_path.name:
                        file_path.rename(file_path.with_name(cleaned_name))
            show_info(self, "Completed", "Filename cleanup finished.")
        except Exception as exc:
            show_error(self, "Filename Cleanup Failed", f"An error occurred:\n{exc}")

