    def load_list_item(self, event, data_dict, entry_name, text_content):
        """Load the selected dictionary entry into the editor widgets."""
        try:
            selected_index = event.widget.curselection()[0]
            selected_name = event.widget.get(selected_index)
            entry_name.delete(0, tk.END)
            entry_name.insert(0, selected_name)
            text_content.delete("1.0", tk.END)
            text_content.insert(
                "1.0", data_dict.get(selected_name, "")
            )
        except IndexError:
            pass

    def load_blurb_item(self, event, data_dict, entry_name, entry_subject, text_content):
        """Load the selected blurb into the editor widgets."""
        try:
            selected_index = event.widget.curselection()[0]
            selected_name = event.widget.get(selected_index)
            blurb_data = data_dict.get(selected_name, {})
            body = blurb_data.get("body", "") if isinstance(blurb_data, dict) else str(blurb_data)
            subject = (
                blurb_data.get("subject", DEFAULT_BLURB_SUBJECT)
                if isinstance(blurb_data, dict)
                else DEFAULT_BLURB_SUBJECT
            )
            entry_name.delete(0, tk.END)
            entry_name.insert(0, selected_name)
            entry_subject.delete(0, tk.END)
            entry_subject.insert(0, subject)
            text_content.delete("1.0", tk.END)
            text_content.insert("1.0", body)
        except IndexError:
            pass
    def save_list_item(self, name, data_dict, listbox, entry_name, text_content):
        """Store the edited entry and refresh related UI controls."""
        item_name = entry_name.get()
        item_content = text_content.get("1.0", tk.END).strip()
        if not item_name:
            messagebox.showerror("Error", "Name cannot be empty.")
            return
        # For CM Headings, ensure content is not empty
        if name == "CM Note Headings" and not item_content:
            messagebox.showerror("Error", "Content (the heading text) cannot be empty.")
            return
        data_dict[item_name] = item_content
        self.save_config()
        self.populate_listbox(listbox, data_dict)
        self.update_main_combos()
        self.update_status_bar(f"{name} '{item_name}' saved.")

    def save_blurb_item(
        self, data_dict, listbox, entry_name, entry_subject, text_content
    ):
        """Store the edited blurb entry including subject."""
        item_name = entry_name.get().strip()
        item_body = text_content.get("1.0", tk.END).strip()
        item_subject = entry_subject.get().strip() or DEFAULT_BLURB_SUBJECT
        if not item_name:
            messagebox.showerror("Error", "Name cannot be empty.")
            return
        data_dict[item_name] = {"body": item_body, "subject": item_subject}
        self.save_config()
        self.populate_listbox(listbox, data_dict)
        self.update_main_combos()
        self.update_status_bar(f"Blurbs '{item_name}' saved.")
