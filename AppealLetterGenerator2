    def save_config(self, event=None):
        """Write the current configuration dictionary to disk."""
        try:
            self.enforce_fax_info_defaults()
            if hasattr(self, "column_widgets"):
                for col, widgets in self.column_widgets.items():
                    self.app_config["column_formats"][col] = widgets["combo"].get()
            if hasattr(self, "combo_account_col"):
                self.app_config["special_cols"][
                    "account_col"
                ] = self.combo_account_col.get()
            if hasattr(self, "combo_claim_user_group_col"):
                self.app_config["special_cols"]["claim_user_group_col"] = self.combo_claim_user_group_col.get()
            if hasattr(self, "combo_contract_code_col"):
                self.app_config["special_cols"]["contract_code_col"] = self.combo_contract_code_col.get()
            if hasattr(self, "combo_contract_name_col"):
                self.app_config["special_cols"]["contract_name_col"] = self.combo_contract_name_col.get()
            if hasattr(self, "entry_excel"):
                self.app_config["excel_path"] = self.entry_excel.get()
            if hasattr(self, "entry_output"):
                self.app_config["output_path"] = self.entry_output.get()
            with open(CONFIG_FILE_PATH, "w", encoding="utf-8") as f:
                json.dump(self.app_config, f, indent=4)
        except Exception as e:
            print(f"Error saving config: {e}")
    def load_config(self):
        """Load configuration values from disk while preserving defaults."""
        try:
            if CONFIG_FILE_PATH.exists():
                with open(CONFIG_FILE_PATH, "r", encoding="utf-8") as f:
                    loaded_config = json.load(f)
                    def deep_update(source, overrides):
                        for key, value in overrides.items():
                            if (
                                isinstance(value, dict)
                                and key in source
                                and isinstance(source[key], dict)
                            ):
                                deep_update(source[key], value)
                            else:
                                source[key] = value
                        return source
                    self.app_config = deep_update(self.app_config, loaded_config)
                    legacy_template_paths = {
                        "letter": loaded_config.get("letter_template_path", ""),
                        "fax": loaded_config.get("fax_template_path", ""),
                    }
                    for template_type, legacy_path in legacy_template_paths.items():
                        if legacy_path and os.path.exists(legacy_path):
                            base_name = Path(legacy_path).stem
                            template_map = self.app_config["templates"].setdefault(template_type, {})
                            if base_name not in template_map:
                                template_map[base_name] = legacy_path
                    for legacy_key in (
                        "letter_template_path",
                        "fax_template_path",
                        "form_templates",
                        "selected_templates",
                        "payer_contacts",
                        "addresses",
                        "cm_headings",
                    ):
                        self.app_config.pop(legacy_key, None)
        except Exception as e:
            print(f"Error loading config: {e}")
            messagebox.showerror(
                "Config Error",
                "Could not load configuration file"
                f" {CONFIG_FILE_PATH}.\nDefaults will be used.\n\nError: {e}",
            )
