    def _on_mousewheel(self, event, canvas):
        """Scroll the column configuration canvas with the mouse wheel."""
        if event.delta:
            canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")
        elif event.num == 4:
            canvas.yview_scroll(-1, "units")
        elif event.num == 5:
            canvas.yview_scroll(1, "units")
