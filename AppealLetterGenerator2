        self.last_notes_file_path = temp_file
        self.notes_text.setPlainText(temp_file.read_text())
        yield from self._dummy_long_task("CM notes extracted")

    def _dummy_long_task(self, completion_message):
        for pct in range(0, 101, 20):
            yield pct, f"Working... {pct}%"
            QtCore.QThread.msleep(50)
        self.status_queue.put(completion_message)
        self.add_run_result({
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "type": completion_message,
            "details": completion_message,
            "output_path": self.entry_output.text().strip(),
        })


