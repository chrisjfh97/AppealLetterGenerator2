    # --- Core Merge Logic (Threaded) ---
    def update_status_bar(self, message=None):
        """Process queued status updates and optionally set a new message."""
        try:
            while True:
                msg = self.status_queue.get_nowait()
                self.status_bar.config(text=msg)
                self.update_idletasks()
        except queue.Empty:
            pass
        if message:
            self.status_bar.config(text=message)
            self.update_idletasks()
        self.after(100, self.update_status_bar)
    def q_print(self, message):
        """Queue a status message to be displayed on the status bar."""
        self.status_queue.put(message)

    def process_error_queue(self):
        """Pull errors from worker threads and surface them in the UI."""
        try:
            while True:
                entry = self.error_queue.get_nowait()
                self.error_entries.append(entry)
                self.display_error_entry(entry)
        except queue.Empty:
            pass
        self.after(200, self.process_error_queue)

    def display_error_entry(self, entry):
        """Render a single error entry in the Treeview with its timestamp."""
        timestamp = entry.get("timestamp", "")
        item = entry.get("item", "")
        item_with_time = f"{item} ({timestamp})" if timestamp else item
        self.error_tree.insert(
            "",
            tk.END,
            values=(item_with_time, entry.get("error", ""), entry.get("action", "")),
        )

    def queue_error(self, item, error, action, fatal=False):
        """Capture an error with next steps and display it immediately."""
        entry = {
            "item": item,
            "error": error,
            "action": action,
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        }
        self.error_queue.put(entry)
        self.record_error_entry(entry)
        if fatal:
            self.fatal_error = True
            self.after(0, self.handle_fatal_error)
        self.q_print(f"ERROR: {item} - {error}")

    def record_error_entry(self, entry):
        """Persist errors to disk so users can revisit details later."""
        try:
            timestamp = entry.get("timestamp") or datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            entry["timestamp"] = timestamp
            ERROR_LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
            with open(ERROR_LOG_PATH, "a", encoding="utf-8") as log_file:
                log_file.write(
                    f"{timestamp}\t{entry.get('item','')}\t{entry.get('error','')}\t{entry.get('action','')}\n"
                )
        except Exception as exc:
            logging.error(f"Failed to record error log entry: {exc}", exc_info=True)

    def load_persisted_error_log(self):
        """Load any previous error entries from disk into the UI."""
        if not ERROR_LOG_PATH.exists():
            return
        try:
            with open(ERROR_LOG_PATH, "r", encoding="utf-8") as log_file:
                for line in log_file:
                    parts = line.rstrip("\n").split("\t")
                    if len(parts) < 4:
                        continue
                    timestamp, item, error, action = (
                        parts[0],
                        parts[1],
                        parts[2],
                        "\t".join(parts[3:]),
                    )
                    entry = {
                        "timestamp": timestamp,
                        "item": item,
                        "error": error,
                        "action": action,
                    }
                    self.error_entries.append(entry)
                    self.display_error_entry(entry)
        except Exception as exc:
            logging.error("Failed to load existing error log entries: %s", exc, exc_info=True)

    def handle_fatal_error(self):
        """Freeze progress messaging once a fatal issue is detected."""
        self.finalize_progress(
            "Processing paused due to a fatal error. Check the Error Log for next steps."
        )

    def clear_error_log(self):
        """Remove all entries from the error tree and cache."""
        for row in self.error_tree.get_children():
            self.error_tree.delete(row)
        self.error_entries.clear()
        try:
            with open(ERROR_LOG_PATH, "w", encoding="utf-8") as log_file:
                log_file.write("")
        except Exception as exc:
            logging.error("Failed to clear error log file: %s", exc, exc_info=True)
        self.q_print("Error log cleared.")

    def request_cancel(self):
        """Signal long-running tasks to stop gracefully."""
        if not self.cancel_requested:
            self.cancel_requested = True
            self.q_print("Cancel requested. Finishing current item before stopping...")
            self.progress_label_var.set("Canceling after current item...")

    def reset_progress(self, total, task_name):
        """Initialize progress tracking for a new task run."""
        self.current_task_total = max(total, 0)
        self.current_task_completed = 0
        self.cancel_requested = False
        self.fatal_error = False
        self.progress_bar.config(maximum=max(total, 1))
        self.progress_var.set(0)
        self.progress_label_var.set(f"{task_name}: 0/{total}")
        self.btn_cancel_tasks.config(state=tk.NORMAL)

    def increment_progress(self, task_name):
        """Advance the progress bar and label safely."""
        self.current_task_completed += 1
        self.progress_var.set(self.current_task_completed)
        total = max(self.current_task_total, 1)
        self.progress_label_var.set(
            f"{task_name}: {self.current_task_completed}/{self.current_task_total}"
        )
        self.update_idletasks()

    def finalize_progress(self, message):
        """Freeze the progress display with a closing message."""
        self.progress_label_var.set(message)
        self.btn_cancel_tasks.config(state=tk.DISABLED)
