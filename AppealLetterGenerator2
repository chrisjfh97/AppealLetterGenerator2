    # --- Run Results Helpers ---
    def apply_run_results_filter(self):
        """Refresh the run results view using the current filter values."""
        self.refresh_run_results_view()

    def reset_run_results_filter(self):
        """Reset filters to their default values."""
        self.run_results_type_var.set("All")
        self.run_results_status_var.set("All")
        self.run_results_search_var.set("")
        self.run_results_sort = {"column": "timestamp", "reverse": True}
        self.refresh_run_results_view()

    def get_filtered_run_results(self):
        """Return run results filtered by type, status, and account search."""
        type_filter = self.run_results_type_var.get()
        status_filter = self.run_results_status_var.get()
        search_text = self.run_results_search_var.get().strip().lower()
        filtered = []
        for entry in self.run_results:
            if type_filter != "All" and entry["run_type"] != type_filter:
                continue
            if status_filter != "All" and entry["status"] != status_filter:
                continue
            if search_text and search_text not in entry["account_number"].lower():
                continue
            filtered.append(entry)
        return filtered

    def sort_run_results_by(self, column):
        """Toggle sorting on the given column and refresh the view."""
        if self.run_results_sort["column"] == column:
            self.run_results_sort["reverse"] = not self.run_results_sort["reverse"]
        else:
            self.run_results_sort = {"column": column, "reverse": False}
        self.refresh_run_results_view()

    def refresh_run_results_view(self):
        """Populate the run results table with filtered and sorted data."""
        if not hasattr(self, "run_results_tree"):
            return
        for item in self.run_results_tree.get_children():
            self.run_results_tree.delete(item)
        results = self.get_filtered_run_results()
        column = self.run_results_sort.get("column", "timestamp")
        reverse = self.run_results_sort.get("reverse", False)
        def sort_key(entry):
            value = entry.get(column)
            if value is None:
                return ""
            return value
        results.sort(key=sort_key, reverse=reverse)
        for entry in results:
            timestamp_str = entry["timestamp"].strftime("%Y-%m-%d %H:%M:%S")
            self.run_results_tree.insert(
                "",
                tk.END,
                values=(
                    timestamp_str,
                    entry["run_type"],
                    entry["account_number"],
                    entry["status"],
                    entry.get("output_path", ""),
                    entry.get("error_message", ""),
                ),
            )

    def record_run_result(
        self, run_type, account_number, status, output_path="", error_message=""
    ):
        """Store a run result entry and update the view on the UI thread."""
        entry = {
            "timestamp": datetime.now(),
            "run_type": run_type,
            "account_number": str(account_number),
            "status": status,
            "output_path": output_path or "",
            "error_message": error_message or "",
        }
        self.after(0, lambda e=entry: self._append_run_result(e))

    def _append_run_result(self, entry):
        self.run_results.append(entry)
        self.refresh_run_results_view()

    def open_selected_output(self):
        """Open the output file/folder for the selected run result."""
        selection = self.run_results_tree.selection()
        if not selection:
            messagebox.showinfo("Open Output", "Please select a run result first.")
            return
        item = selection[0]
        values = self.run_results_tree.item(item, "values")
        output_path = values[4]
        if not output_path:
            messagebox.showwarning("Open Output", "No output path recorded for this entry.")
            return
        if not os.path.exists(output_path):
            messagebox.showwarning(
                "Open Output", f"The path does not exist:\n{output_path}"
            )
            return
        try:
            if sys.platform.startswith("win"):
                os.startfile(output_path)
            elif sys.platform == "darwin":
                subprocess.Popen(["open", output_path])
            else:
                subprocess.Popen(["xdg-open", output_path])
        except Exception as exc:
            messagebox.showerror(
                "Open Output", f"Failed to open path:\n{output_path}\n\n{exc}"
            )

    def view_selected_error(self):
        """Show a dialog with the error message for the selected entry."""
        selection = self.run_results_tree.selection()
        if not selection:
            messagebox.showinfo("Error Details", "Please select a run result first.")
            return
        item = selection[0]
        values = self.run_results_tree.item(item, "values")
        error_message = values[5]
        if not error_message:
            messagebox.showinfo("Error Details", "No error message recorded for this entry.")
            return
        messagebox.showinfo("Error Details", error_message)
    # --- List Manager (Address/Blurb/CM Heading) Logic ---
    def populate_listbox(self, listbox, data_dict):
        """Populate a listbox with the sorted keys of a dictionary."""
        listbox.delete(0, tk.END)
        for key in sorted(data_dict.keys()):
            listbox.insert(tk.END, key)
    def load_list_item(self, event, data_dict, entry_name, text_content):
        """Load the selected dictionary entry into the editor widgets."""
        try:
            selected_index = event.widget.curselection()[0]
            selected_name = event.widget.get(selected_index)
            entry_name.delete(0, tk.END)
            entry_name.insert(0, selected_name)
            text_content.delete("1.0", tk.END)
            text_content.insert(
                "1.0", data_dict.get(selected_name, "")
            )
        except IndexError:
            pass
    def save_list_item(self, name, data_dict, listbox, entry_name, text_content):
        """Store the edited entry and refresh related UI controls."""
        item_name = entry_name.get()
        item_content = text_content.get("1.0", tk.END).strip()
        if not item_name:
            messagebox.showerror("Error", "Name cannot be empty.")
            return
