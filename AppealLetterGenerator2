    def ensure_unique_template_name(self, base_name, template_dict):
        """Return a unique template name by adding a counter when needed."""
        name = base_name.strip() if base_name else "Template"
        if name not in template_dict:
            return name
        counter = 2
        while True:
            candidate = f"{name} ({counter})"
            if candidate not in template_dict:
                return candidate
            counter += 1

    def get_template_folder_key(self, template_type):
        """Map a template type to its default folder key."""
        return {
            "letter": "Letter Templates",
            "fax": "Fax Coversheets",
            "form": "Forms",
        }.get(template_type, "Forms")

    def get_template_folder_path(self, template_type):
        """Return the default folder path for a template type."""
        folder_key = self.get_template_folder_key(template_type)
        return USER_PATHS.get(folder_key, USER_PATHS.get("root", BASE_DIR))

    def is_path_within(self, path, directory):
        """Return True if path is within directory."""
        try:
            Path(path).resolve().relative_to(Path(directory).resolve())
            return True
        except ValueError:
            return False

    def move_template_to_default_folder(self, template_type, template_path):
        """Move a template into the default folder if it isn't already there."""
        if not template_path or not os.path.exists(template_path):
            return template_path
        default_dir = self.get_template_folder_path(template_type)
        if not default_dir:
            return template_path
        default_dir = Path(default_dir)
        if self.is_path_within(template_path, default_dir):
            return template_path
        try:
            default_dir.mkdir(parents=True, exist_ok=True)
            target_path = default_dir / Path(template_path).name
            if target_path.exists():
                stem = target_path.stem
                suffix = target_path.suffix
                counter = 2
                while target_path.exists():
                    target_path = default_dir / f"{stem} ({counter}){suffix}"
                    counter += 1
            shutil.move(template_path, target_path)
            return str(target_path)
        except Exception as exc:
            messagebox.showwarning(
                "Template Move Failed",
                f"Unable to move template to the default folder:\n{exc}",
            )
            return template_path

    def get_template_mapping(self, template_type):
        """Return the mapping dict for a template type."""
        return self.app_config.get("templates", {}).get(template_type, {})

    def update_main_combos(self):
        """Populate active dropdown controls from config data."""
        blurb_keys = ["(None)"] + sorted(list(self.app_config["blurbs"].keys()))
        if hasattr(self, 'combo_blurb'):
            self.combo_blurb["values"] = blurb_keys
            self.combo_blurb.set("(None)")
        if hasattr(self, 'combo_cm_heading'):
            heading_keys = ["(None)"] + sorted(list(self.app_config["cm_headings"].keys()))
            self.combo_cm_heading["values"] = heading_keys
            self.combo_cm_heading.set("(None)")

    def get_blurb_payload(self, blurb_key):
        """Return the blurb body and subject for the selected key."""
        if not blurb_key or blurb_key == "(None)":
            return "", DEFAULT_BLURB_SUBJECT
        blurb_data = self.app_config["blurbs"].get(blurb_key, {})
        if isinstance(blurb_data, dict):
            return blurb_data.get("body", ""), blurb_data.get(
                "subject", DEFAULT_BLURB_SUBJECT
            )
        return str(blurb_data), DEFAULT_BLURB_SUBJECT

