    def run_split_cld(self, file_path, output_folder, date_str, client_str):
        """Execute the PDF splitting process. (Adapted from user code)"""
        delimit_str = "."
        suffix_str = "cld"
        base_output_path = os.path.join(output_folder, date_str)
        try:
            doc = fitz.open(file_path)
            num_pages = len(doc)
            page_breaks = self.get_page_breaks(file_path)
            if not page_breaks:
                messagebox.showerror(
                    "Error",
                    "The text 'total reimbursement' was not found in this PDF.\n\n"
                    "Please verify that the correct PDF was selected."
                )
                doc.close()
                return
            i = 0
            file_count = 0
            while i < num_pages:
                if page_breaks:
                    end = page_breaks.pop(0)
                else:
                    end = num_pages - 1
                if i > end:
                    break
                start = i
                new_doc = fitz.open()
                new_doc.insert_pdf(doc, from_page=start, to_page=end)
                # Extract refnum from the last page of the section
                text = doc[end].get_text()
                # Original regex: r"\s*\(\s*(.*?)\s*\)\s*- F"
                match = re.search(r"\s*\(\s*(.*?)\s*\)\s*- F", text)
                if match:
                    refnum = match.group(1).strip()
                    # Sanitize refnum just in case
                    refnum = re.sub(r'[<>:"/\\|?*]', "", refnum)
                    # Create the subfolder path inside the day's output
                    path = os.path.join(base_output_path, refnum)
                    if not os.path.exists(path):
                        os.makedirs(path)
                    # Build the final file name
                    final_name = f"{date_str}{delimit_str}{client_str}{delimit_str}{refnum}{delimit_str}{suffix_str}.pdf"
                    final_path = os.path.join(path, final_name)
                    try:
                        new_doc.save(final_path)
                        file_count += 1
                        self.q_print(f"Saved: {final_name}")
                    except Exception as e:
                        self.q_print(f"ERROR: Failed to save {final_name}: {str(e)}")
                        messagebox.showerror("File Save Error", f"Failed to save {final_name}: {str(e)}")
                else:
                    self.q_print(f"WARNING: Refnum not found on page {end+1}. Skipping this section.")
                new_doc.close()
                i = end + 1
            doc.close()
            self.q_print(f"CLD Split complete. {file_count} files created.")
            messagebox.showinfo("Completed", f"CLD Split complete.\n{file_count} files created in: {base_output_path}")
        except Exception as e:
            self.q_print(f"Error during CLD split: {e}")
            messagebox.showerror("CLD Split Failed", f"An error occurred:\n{e}")
            import traceback
            traceback.print_exc()
        finally:
            self.set_buttons_state("normal")
