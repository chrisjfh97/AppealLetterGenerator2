        self.error_table.setItem(row, 1, QtWidgets.QTableWidgetItem(error))
        self.error_table.setItem(row, 2, QtWidgets.QTableWidgetItem(action))
        self.error_entries.append({"item": item, "error": error, "action": action})
        self.save_error_log()

    def update_status_bar(self):
        while not self.status_queue.empty():
            message = self.status_queue.get()
            self.progress_label.setText(message)
        while not self.error_queue.empty():
            item, error_msg, action = self.error_queue.get()
            self.append_error(item, error_msg, action)

    # -------------------- Config Persistence --------------------
    def load_config(self):
        if CONFIG_FILE_PATH.exists():
            try:
                with open(CONFIG_FILE_PATH, "r", encoding="utf-8") as f:
                    self.app_config.update(json.load(f))
            except Exception:
                logging.exception("Failed to load config; using defaults")

    def save_config(self):
        self.app_config["supporting_doc_path"] = self.entry_support_doc.text() if hasattr(self, "entry_support_doc") else self.app_config.get("supporting_doc_path", "")
        self.app_config["supporting_doc_suffix"] = self.entry_support_suffix.text() if hasattr(self, "entry_support_suffix") else self.app_config.get("supporting_doc_suffix", "addinfo")
        self.app_config["fax_info"]["user_name"] = self.entry_user_name.text() if hasattr(self, "entry_user_name") else ""
        self.app_config["fax_info"]["user_phone"] = self.entry_user_phone.text() if hasattr(self, "entry_user_phone") else ""
        self.app_config["fax_info"]["user_fax"] = self.entry_user_fax.text() if hasattr(self, "entry_user_fax") else ""
        try:
            with open(CONFIG_FILE_PATH, "w", encoding="utf-8") as f:
                json.dump(self.app_config, f, indent=2)
        except Exception:
            logging.exception("Failed to save config")

    def save_error_log(self):
        try:
            with open(ERROR_LOG_PATH, "w", encoding="utf-8") as f:
                json.dump(self.error_entries, f, indent=2)
        except Exception:
            logging.exception("Failed to save error log")

    def load_persisted_error_log(self):
        if ERROR_LOG_PATH.exists():
            try:
                with open(ERROR_LOG_PATH, "r", encoding="utf-8") as f:
                    self.error_entries = json.load(f)
                for entry in self.error_entries:
                    self.append_error(entry.get("item", ""), entry.get("error", ""), entry.get("action", ""))
            except Exception:
                logging.exception("Failed to load error log")

