                return row.get("Acronym", "")
        return ""

    def _resolve_required_templates(self, ugid, contract_code, needs_form):
        def find_template(template_type, target_filename):
            default_dir = Path(self.get_template_folder_path(template_type))
            candidate = default_dir / target_filename
            if candidate.exists():
                return str(candidate)
            for path in self.get_template_mapping(template_type).values():
                if Path(path).name.lower() == target_filename.lower() and Path(path).exists():
                    return path
            return ""

        letter_path = find_template("letter", f"{ugid} - Letter template.docx")
        if not letter_path or not os.path.exists(letter_path):
            return None, None, "Letter template missing"
        if needs_form:
            form_path = find_template("form", f"{ugid} - Form - {contract_code}.docx")
            if not form_path or not os.path.exists(form_path):
                return None, None, "Form template missing"
            return letter_path, form_path, None
        fax_path = find_template("fax", f"{ugid} - Fax.docx")
        if not fax_path or not os.path.exists(fax_path):
            return None, None, "Fax template missing"
        return letter_path, fax_path, None

    def _parse_selected_method(self, mapping_row):
        method_to_use = str(mapping_row.get("MethodToUse", "")).strip()
        if method_to_use not in {"1", "2", "3"}:
            return None, None, "Invalid MethodToUse value"
        field_name = {
            "1": "1st Method + Contact (1)",
            "2": "2nd Method + Contact (2)",
            "3": "3rd Method + Contact (3)",
        }[method_to_use]
        method_value = str(mapping_row.get(field_name, "")).strip()
        if method_value.startswith("Fax - "):
            return "Fax", method_value.replace("Fax - ", "", 1).strip(), None
        if method_value.startswith("Mail - "):
            return "Mail", method_value.replace("Mail - ", "", 1).strip(), None
        return None, None, "Invalid method format"

    def run_generate_appeals(self):
        failures = []
        successes = []
        try:
            all_rows = list(self.df.iterrows())
            self.reset_progress(len(all_rows), "Generate Appeals")
            for index, row in all_rows:
                try:
                    account = sanitize_path_component(row.get(self.account_col_name, ""))
                    ugid = sanitize_path_component(row.get(self.claim_user_group_col, ""))
                    contract_code = sanitize_path_component(row.get(self.contract_code_col, ""))
                    contract_name = sanitize_path_component(row.get(self.contract_name_col, ""))
                    if not ugid or not contract_code:
                        failures.append((index, "Mapping not found"))
                        self.increment_progress("Generate Appeals")
                        continue
                    mapping_row = self._lookup_mapping_row(ugid, contract_code)
                    if not mapping_row:
                        failures.append((index, "Mapping not found"))
                        self.increment_progress("Generate Appeals")
                        continue
                    method_type, address_block, method_err = self._parse_selected_method(mapping_row)
                    if method_err:
                        failures.append((index, method_err))
                        self.increment_progress("Generate Appeals")
                        continue
                    form_flag = str(mapping_row.get("Form?", "")).strip().lower() in {"true", "1", "yes", "y"}
