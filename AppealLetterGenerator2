                for part in parts:
                    if part.upper() not in credentials:
                        last_name_parts.append(part)
                cleaned_last_name = " ".join(last_name_parts).title()
                return cleaned_last_name
            data["Provider First Name"] = data["Provider First Name"].apply(clean_first_name)
            data["Provider Last Name"] = data["Provider Last Name"].apply(clean_last_name)
            data["Provider Name"] = data["Provider First Name"].str.cat(
