    def _load_excel_data(self, filepath):
        """Helper to load data after UI path is updated."""
        try:
            self.df = pd.read_excel(filepath)
            original_columns = list(self.df.columns)
            cleaned_columns = [clean_column_name(col) for col in original_columns]
            if len(cleaned_columns) != len(set(cleaned_columns)):
                messagebox.showwarning(
                    "Duplicate Columns",
                    "Warning: Cleaned column names have duplicates.",
                )
            self.df.columns = cleaned_columns
            self.ensure_dos_column()
            self.q_print(f"Cleaned column names: {list(self.df.columns)}")
            self.update_status_bar("Excel loaded. Populating column configuration...")
            self.populate_column_config_tab()
            if hasattr(self, 'placeholder_text'): # Check if placeholder tab exists
                self.update_placeholder_list()
            self.save_config()
        except Exception as e:
            self.df = None
            messagebox.showerror(
                "Error", f"Failed to read Excel file or clean columns:\n{e}"
            )
            self.update_status_bar("Error loading Excel file.")

    def ensure_dos_column(self):
        """Create a DOS column if missing using available date ranges."""
        if self.df is None or "DOS" in self.df.columns:
            return
        date_pairs = [
            ("From_Date", "To_Date"),
            ("Admission_Date", "Discharge_Date"),
        ]
        for start_col, end_col in date_pairs:
            if start_col in self.df.columns and end_col in self.df.columns:
                self.df["DOS"] = self.df.apply(
                    lambda row: self._format_dos_range(
                        row.get(start_col), row.get(end_col)
                    ),
                    axis=1,
                )
                return

    def _format_dos_range(self, start_value, end_value):
        """Return a formatted DOS string from two dates."""
        start_date = pd.to_datetime(start_value, errors="coerce")
        end_date = pd.to_datetime(end_value, errors="coerce")
        if pd.isna(start_date) and pd.isna(end_date):
            return ""
        if pd.isna(end_date) or start_date == end_date:
            return start_date.strftime("%m/%d/%Y")
        if pd.isna(start_date):
            return end_date.strftime("%m/%d/%Y")
        eldest = min(start_date, end_date)
        newest = max(start_date, end_date)
        if eldest == newest:
            return eldest.strftime("%m/%d/%Y")
        return f"{eldest.strftime('%m/%d/%Y')} - {newest.strftime('%m/%d/%Y')}"

    def extract_first_dos_date(self, value):
        """Extract the first date from a DOS value."""
        if pd.isna(value):
            return ""
        if isinstance(value, (dt.date, dt.datetime, pd.Timestamp)):
            return pd.to_datetime(value).strftime("%m/%d/%Y")
        text = str(value).strip()
        if not text:
            return ""
        match = re.search(r"\d{1,2}/\d{1,2}/\d{2,4}", text)
        if match:
            parsed = pd.to_datetime(match.group(0), errors="coerce")
            if parsed is not pd.NaT:
                return parsed.strftime("%m/%d/%Y")
        return text

    def _add_notes_table(self, workbook_path):
        """Add a formatted table to the notes worksheet."""
        try:
            workbook = load_workbook(workbook_path)
            worksheet = workbook.active
            max_row = worksheet.max_row
            max_col = worksheet.max_column
            if max_row < 2 or max_col < 1:
                return
            table_ref = f"A1:{get_column_letter(max_col)}{max_row}"
            table = Table(displayName="tblNotes", ref=table_ref)
            style = TableStyleInfo(
                name="TableStyleMedium9",
                showFirstColumn=False,
                showLastColumn=False,
                showRowStripes=True,
                showColumnStripes=False,
            )
            table.tableStyleInfo = style
            worksheet.add_table(table)
            workbook.save(workbook_path)
        except Exception as exc:
            self.q_print(f"Warning: Failed to add table formatting: {exc}")
