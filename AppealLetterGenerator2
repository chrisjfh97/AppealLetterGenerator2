            )
            data["Provider Name"] = data["Provider Name"].str.strip()
            data["Provider Last Name"] = data["Provider Last Name"].apply(
                remove_credentials_from_last_name
            )
            data["CPT_Code_Count"] = data.groupby(["Reference 1", "CPT Code", "Expected"])[
                "CPT Code"
            ].transform("count")
            def create_procedure_text(row):
                claim_dates = "days" if "-" in row["DOS"] else "lines billed"
                if row["CPT_Code_Count"] > 1:
                    return f"Procedure Code {row['CPT Code']}, contracted rate is ${row['Expected']:.2f} x {int(row['CPT_Code_Count'])} {claim_dates} = ${row['Expected'] * row['CPT_Code_Count']:.2f}"
                else:
                    return f"Procedure Code {row['CPT Code']}, contracted rate is ${row['Expected']:.2f}"
            data["Procedure Text"] = data.apply(create_procedure_text, axis=1)
            def handle_Duplicate_ICNs(values):
                non_nan_values = [val for val in values if pd.notna(val)]
                unique_values = set(non_nan_values)
                concatenated_values = ", ".join(str(v) for v in unique_values)
                return concatenated_values
            self.q_print("Aggregating data...")
            aggregated_data = (
                data.groupby(["Reference 1"])
                .agg(
                    {
                        "Units": lambda x: "\n".join(str(val) for val in x),
                        "CPT Code": lambda x: ", ".join(str(val) for val in x),
                        "Expected": "sum",
                        "Allowed": "sum",
                        "Variance": "sum",
                        "Procedure Text": lambda x: "\n".join(str(val) for val in set(x)),
                        "Line Item ICNs": handle_Duplicate_ICNs,
                        "Contract Code": "first",
                        "Contract Name": "first",
                        "Provider Name": "first",
                        "Provider First Name": "first",
                        "Provider Last Name": "first",
                        "NPI": "first",
                        "Provider TIN": "first",
                        "Payor's Member ID": "first",
                        "Patient Name": "first",
                        "Patient First Name": "first",
                        "Patient Last Name": "first",
                        "Patient DOB": "first",
                        "From Date": "first",
                        "DOS": "first",
                        "POS": "first",
                        "Procedure Count": "first",
                        "Client": "first",
                    }
                )
                .reset_index()
            )
            # Initialize optional metadata columns expected by downstream workflows
            aggregated_data["Percentage"] = ""
            aggregated_data["RBRVS Year"] = ""
            aggregated_data["Provider Specialty"] = ""
            aggregated_data["Contract Effective Date"] = ""
            # Ensure the cleaned report columns follow the standard export order
            column_order = [
                "Client", "Reference 1", "Contract Code", "Contract Name",
                "Contract Effective Date", "RBRVS Year", "Percentage",
                "Provider Name", "Provider First Name", "Provider Last Name", "NPI",
                "Provider TIN", "Provider Specialty", "Payor's Member ID",
                "Patient Name", "Patient First Name", "Patient Last Name",
                "Patient DOB", "From Date", "DOS", "POS", "Procedure Count",
                "Units", "CPT Code", "Expected", "Allowed", "Variance",
                "Procedure Text", "Line Item ICNs",
            ]
            aggregated_data = aggregated_data.reindex(columns=column_order)
            aggregated_data.rename(
                columns={
                    "CPT Code": "CPT Code List",
                    "Variance": "Total Variance",
                    "Expected": "Total Expected",
                    "Allowed": "Total Allowed",
                },
                inplace=True,
            )
            aggregated_data["Total Expected"] = aggregated_data["Total Expected"].map(
                "${:,.2f}".format
            )
            aggregated_data["Total Allowed"] = aggregated_data["Total Allowed"].map(
                "${:,.2f}".format
            )
            aggregated_data["Total Variance"] = aggregated_data["Total Variance"].map(
                "${:,.2f}".format
            )
            aggregated_data["Payor's Member ID"] = aggregated_data["Payor's Member ID"].astype(
                "str"
            )
            aggregated_data.columns = [
                col.replace(" ", "_").replace("'", "") for col in aggregated_data.columns
            ]
            aggregated_data["Patient_DOB"] = aggregated_data["Patient_DOB"].dt.strftime(
                "%m/%d/%Y"
            )
            aggregated_data["From_Date"] = aggregated_data["From_Date"].dt.strftime("%m/%d/%Y")
            # --- FIXED PATH ---
            downloads_folder = os.path.join(os.environ["USERPROFILE"], "Downloads")
            report_filename = f"ClaimsForReview_{timestamp}.xlsx"
            report_path = os.path.join(downloads_folder, report_filename)
            # --- END FIXED PATH ---
            self.q_print(f"Saving cleaned report to {report_path}...")
            aggregated_data.to_excel(report_path, index=False)
            messagebox.showinfo(
                "Report Cleaned",
                (
                    f"Cleaned report saved to:\n{report_path}\n\n"
                    "The Excel File field has been updated automatically."
                ),
            )
            self.after(0, lambda: self.load_excel(report_path))
            self.q_print("Report cleaning complete.")
        except Exception as e:
            self.q_print(f"Error cleaning report: {e}")
            messagebox.showerror("Cleaning Failed", f"An error occurred:\n{e}")
            import traceback
            traceback.print_exc()
        finally:
            self.set_buttons_state("normal")
