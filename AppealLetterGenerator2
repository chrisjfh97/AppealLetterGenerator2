    def validate_merge_tasks(self, template_path, tasks, process_label):
        """Render all contexts to memory to catch template issues before writing."""
        template_name = os.path.basename(template_path)
        for index, task in enumerate(tasks, start=1):
            try:
                doc = DocxTemplate(template_path)
                doc.render(task.get("context", {}))
                buffer = io.BytesIO()
                doc.save(buffer)
            except Exception as exc:
                error_msg = (
                    f"{process_label} validation failed on row {index} "
                    f"(account {task.get('account_number', 'unknown')}): {exc}"
                )
                self.q_print(error_msg)
                messagebox.showerror(
                    f"{process_label} Validation Failed",
                    (
                        f"Unable to render template '{template_name}' for row {index}.\n\n"
                        f"Details: {exc}"
                    ),
                )
                return False
        return True

    def run_letter_merge(self, tasks):
        """Task 1: Create letters."""
        try:
            total_rows = len(tasks)
            errors = []
            completed = 0
            for index, task in enumerate(tasks):
                if self.cancel_requested or self.fatal_error:
                    break
                self.q_print(f"Processing letter {index + 1}/{total_rows}...")
                output_path = ""
                account_number = ""
                account_folder = ""
                try:
                    account_number = task.get("account_number", "")
                    day_folder = os.path.join(self.output_path, self.file_date_str)
                    account_folder = os.path.join(day_folder, account_number)
                    os.makedirs(account_folder, exist_ok=True)
                    save_path_base = os.path.join(
                        account_folder, task.get("file_basename", "")
                    )
                    merge_data = task.get("context", {})
                    output_path = self.create_and_save_doc(
                        self.letter_template_path, save_path_base, merge_data
                    )
                    if not output_path:
                        raise Exception("Failed to create letter document.")
                    completed += 1
                    self.record_run_result(
                        "Letters",
                        account_number,
                        "Success",
                        output_path=output_path,
                    )
                except Exception as entry_error:
                    errors.append(account_number or f"Row {index + 1}")
                    logging.error(
                        "Letter generation failed for %s: %s",
                        account_number or f"row {index + 1}",
                        entry_error,
                        exc_info=True,
                    )
                    self.record_run_result(
                        "Letters",
                        account_number,
                        "Error",
                        output_path=output_path or account_folder,
                        error_message=str(entry_error),
                    )
                    continue
            self.q_print("Letter merge completed successfully!")
            if errors:
                messagebox.showwarning(
                    "Letter Merge Completed with Issues",
                    "Letter merge completed with some errors. Check the "
                    "'Recent Run Results' tab for details.",
                )
            else:
                messagebox.showinfo("Success", "Letter merge completed.")
        except Exception as e:
            self.q_print(f"Error during letter merge: {e}")
            self.finalize_progress("Letter merge encountered an error.")
            messagebox.showerror("Letter Merge Failed", f"An error occurred:\n{e}")
            if "account_number" in locals():
                self.record_run_result(
                    "Letters",
                    locals().get("account_number", ""),
                    "Error",
                    output_path=output_path if "output_path" in locals() else "",
                    error_message=str(e),
                )
        finally:
            self.set_buttons_state("normal")
