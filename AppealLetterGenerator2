    def run_clean_special_chars(self, root_folder):
        """Remove selected special characters from filenames under root_folder."""
        renamed_count = 0
        skipped_count = 0
        try:
            for dirpath, _, filenames in os.walk(root_folder):
                for filename in filenames:
                    new_name = self.generate_clean_filename(filename)
                    if not new_name:
                        skipped_count += 1
                        continue
                    if new_name == filename:
                        continue
                    src = os.path.join(dirpath, filename)
                    dst = self.resolve_unique_filename(dirpath, new_name)
                    if dst is None:
                        skipped_count += 1
                        continue
                    try:
                        os.rename(src, dst)
                        renamed_count += 1
                    except OSError as exc:
                        logging.error(
                            "Failed to rename '%s' -> '%s': %s",
                            src,
                            dst,
                            exc,
                            exc_info=True,
                        )
                        skipped_count += 1
            summary = (
                f"Filename cleanup complete. {renamed_count} file(s) renamed."
                f"{' ' + str(skipped_count) + ' file(s) skipped.' if skipped_count else ''}"
                f"\nLocation: {root_folder}"
            )
            self.q_print(summary)
            messagebox.showinfo("Completed", summary)
        except Exception as exc:  # Catch-all to surface unexpected errors
            logging.error("Unexpected error during filename cleanup: %s", exc, exc_info=True)
            messagebox.showerror("Filename Cleanup Failed", f"An error occurred:\n{exc}")
        finally:
            self.set_buttons_state("normal")
    def generate_clean_filename(self, filename):
        """Return a sanitized filename (without path)."""
        name, ext = os.path.splitext(filename)
        cleaned = re.sub(r"[-.\s]", "", name)
        if not cleaned:
            logging.warning(
                "Skipping file '%s' because removing special characters would "
                "result in an empty name.",
                filename,
            )
            return None
        return f"{cleaned}{ext}"
    def resolve_unique_filename(self, directory, filename):
        """Ensure destination filename does not overwrite existing files."""
        base, ext = os.path.splitext(filename)
        candidate = os.path.join(directory, filename)
        if not os.path.exists(candidate):
            return candidate
        counter = 1
        while counter < 1000:
            new_candidate = os.path.join(directory, f"{base}_{counter}{ext}")
            if not os.path.exists(new_candidate):
                return new_candidate
            counter += 1
        logging.error(
            "Unable to resolve a unique filename for '%s' in '%s' after 999 attempts.",
            filename,
            directory,
        )
        return None
