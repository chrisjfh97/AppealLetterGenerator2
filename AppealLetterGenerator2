            self.column_table.insertRow(row)
            self.column_table.setItem(row, 0, QtWidgets.QTableWidgetItem(str(col)))
            combo = QtWidgets.QComboBox()
            combo.addItems(["Text", "Date (MM/DD/YYYY)", "Monetary ($#,##.##)", "Percentage (##.##%)"])
            combo.setCurrentText(self.app_config["column_formats"].get(col, "Text"))
            self.column_table.setCellWidget(row, 1, combo)

