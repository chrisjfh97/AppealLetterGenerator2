                last_name = " ".join(last_name_parts).title()
                if credential:
                    last_name = f"{last_name} {credential}"
                return last_name
            def remove_credentials_from_last_name(last_name):
                name = last_name.replace("-", "").replace(".", "")
                parts = name.split()
