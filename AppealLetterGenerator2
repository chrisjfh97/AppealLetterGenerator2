                    "PNP-BC", "PNP-PC", "RCP", "RD", "RD-AP", "RD/LD", "RDN", "RDN-AP",
                    "RN", "RNIII", "RNP", "RPh", "RPT", "SLP", "SW", "VA-BC", "WCC",
                    "WOCN",
                ]
            )
            def clean_first_name(name):
                if isinstance(name, str):
                    name = name.replace(".", "")
                    name = name.rstrip("-")
                    return name.title()
                else:
                    return ""
            def clean_last_name(name):
                name = name.replace("-", "").replace(".", "")
                parts = name.split()
                last_name_parts = []
                credential = ""
                for part in parts:
                    if part.upper() in credentials:
                        credential = part.upper()
                    else:
                        last_name_parts.append(part)
                last_name = " ".join(last_name_parts).title()
                if credential:
