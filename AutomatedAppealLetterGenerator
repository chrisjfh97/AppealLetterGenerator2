    def run_generate_appeals(self):
        """Generate appeals grouped by Claim User Group and Contract Code."""

        failures = []
        successes = []
        try:
            row_groups = self.get_generation_row_groups()
            total_rows = sum(len(group_rows) for _, group_rows in row_groups)
            self.reset_progress(total_rows, "Generate Appeals")

            for (ugid, contract_code), group_rows in row_groups:
                group_error = None
                if not ugid or not contract_code:
                    group_error = "Mapping not found"
                else:
                    mapping_row = self._lookup_mapping_row(ugid, contract_code)
                    if not mapping_row:
                        group_error = "Mapping not found"
                    else:
                        method_type, method_contact, method_err = self._parse_selected_method(mapping_row)
                        if method_err:
                            group_error = method_err
                        else:
                            form_flag = str(mapping_row.get("Form?", "")).strip().lower() in {"true", "1", "yes", "y"}
                            letter_template, second_template, template_err = self._resolve_required_templates(ugid, contract_code, form_flag)
                            if template_err:
                                group_error = template_err
                            else:
                                mailing_folder = self._find_mailing_folder(ugid)
                                if method_type == "Mail" and not mailing_folder:
                                    group_error = "Missing Mailing Folder for Claim User Group"

                if group_error:
                    for index, _ in group_rows:
                        failures.append((index, group_error))
                        self.increment_progress("Generate Appeals")
                    continue

                payer_name = clean_text_value(mapping_row.get("Payer Name", ""))
                payer_attn = clean_text_value(mapping_row.get("Attention To", ""))
                address_block = build_contact_address_block(
                    payer_name, payer_attn, method_type, method_contact
                )
                route_folder = "Faxed Letters" if method_type == "Fax" else "Mailed Letters"
                acronym = self._find_acronym(ugid)

                for index, row in group_rows:
                    try:
                        account = sanitize_path_component(row.get(self.account_col_name, ""))
                        contract_name = sanitize_path_component(row.get(self.contract_name_col, ""))
                        now = datetime.now()
                        path_parts = [
                            sanitize_path_component(ugid),
                            route_folder,
                            sanitize_path_component(f"{contract_code} - {contract_name}"),
                            sanitize_path_component(f"{now.strftime('%Y')}"),
                            sanitize_path_component(f"{now.strftime('%m.%Y')}"),
                            sanitize_path_component(f"{now.strftime('%m%d%y')}"),
                            sanitize_path_component(account),
                        ]

                        contract_dir = (
                            Path(self.output_path)
                            / sanitize_path_component(ugid)
                            / route_folder
                            / sanitize_path_component(f"{contract_code} - {contract_name}")
                        )
                        try:
                            contract_dir.mkdir(parents=True, exist_ok=True)
                            if method_type == "Fax" and method_contact:
                                fax_file = contract_dir / "Fax Number.txt"
                                try:
                                    if fax_file.exists():
                                        existing = fax_file.read_text(encoding="utf-8").strip()
                                        if existing != method_contact:
                                            fax_file.write_text(method_contact + "\n", encoding="utf-8")
                                    else:
                                        fax_file.write_text(method_contact + "\n", encoding="utf-8")
                                except Exception as exc:
                                    self.q_print(f"Failed to write Fax Number.txt in {contract_dir}: {exc}")
                        except Exception:
                            pass

                        target_dir = Path(self.output_path)
                        for part in path_parts:
                            target_dir = target_dir / sanitize_path_component(part)
                        target_dir.mkdir(parents=True, exist_ok=True)

                        row_data = self.format_row_data(row)
                        blurb_body, blurb_subject, blurb_err = self.get_row_blurb_payload(row)
                        if blurb_err:
                            failures.append((index, blurb_err))
                            self.increment_progress("Generate Appeals")
                            continue

                        context = self.build_letter_merge_dict(row_data, blurb_body, blurb_subject)
                        context["AddressBlock"] = address_block
                        context["payer_name"] = payer_name
                        context["payer_fax"] = method_contact if method_type == "Fax" else ""
                        context["payer_attn"] = payer_attn

                        filename_base = sanitize_path_component(f"{self.file_date_str}.{acronym}.{account}")
                        letter_base = str(target_dir / f"{filename_base} - Letter")
                        letter_path = self.create_and_save_doc(letter_template, letter_base, context)
                        if not letter_path:
                            failures.append((index, "Letter generation error"))
                            self.increment_progress("Generate Appeals")
                            continue

                        if form_flag:
                            second_base = str(target_dir / f"{filename_base} - Form")
                            output2 = self.create_and_save_doc(second_template, second_base, context)
                        else:
                            fax_context = dict(context)
                            fax_context["total_pages"] = max(1, get_docx_page_count(letter_path))
                            second_base = str(target_dir / f"{filename_base} - Fax")
                            output2 = self.create_and_save_doc(second_template, second_base, fax_context)

                        if not output2:
                            failures.append((index, "Secondary document generation error"))
                            self.cleanup_failed_output(target_dir, [letter_path])
                            self.increment_progress("Generate Appeals")
                            continue

                        successes.append({
                            "index": index,
                            "letter_path": letter_path,
                            "secondary_path": output2,
                            "generated_paths": [letter_path, output2],
                            "method_type": method_type,
                            "payer_name": payer_name,
                            "payer_fax": method_contact if method_type == "Fax" else "",
                            "payer_attn": payer_attn,
                            "address_block": address_block,
                            "mailing_folder": mailing_folder,
                            "ugid": ugid,
                            "workflow_reason": row.get("Workflow_Reason", ""),
                            "account": account,
                        })
                    except Exception as row_exc:
                        failures.append((index, f"Row error: {row_exc}"))
                    finally:
                        self.increment_progress("Generate Appeals")

            self.last_successful_items = successes
            if successes:
                failures.extend(self.copy_mail_outputs_to_mailing_folders(successes))
            if failures:
                self.export_failures(failures)
            if successes:
                self.extract_notes_from_successes(successes)
            msg = f"Generation finished. Success: {len(successes)} | Failed: {len(failures)}"
            self.finalize_progress(msg)
            if failures:
                messagebox.showwarning(
                    "Generation Completed With Failures",
                    f"{msg}\n\nA failed accounts workbook was exported to your Downloads folder.",
                )
            else:
                messagebox.showinfo("Generation Complete", msg)
        finally:
            self.set_buttons_state("normal")

    def export_failures(self, failures):
        """Write failed rows to Downloads with original columns plus reason."""

        if not failures:
            return
        failed_indices = [idx for idx, _ in failures]
        reason_map = {idx: reason for idx, reason in failures}
        failure_df = self.df.loc[failed_indices].copy()
        failure_df["Failure Reason"] = [reason_map.get(i, "") for i in failure_df.index]
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        downloads_path = Path.home() / "Downloads"
        downloads_path.mkdir(parents=True, exist_ok=True)
        out_path = downloads_path / f"Failed_Rows_{timestamp}.xlsx"
        failure_df.to_excel(out_path, index=False)
        self.q_print(f"Failure file created: {out_path}")
