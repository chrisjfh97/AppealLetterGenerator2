            self.combo_account_col.set(matched_account_col)
        else:
            self.combo_account_col.set("")
        if hasattr(self, "combo_claim_user_group_col"):
            self.combo_claim_user_group_col["values"] = col_names
            saved = saved_cols.get("claim_user_group_col", "")
            self.combo_claim_user_group_col.set(self.match_saved_column_name(saved, col_names))
        if hasattr(self, "combo_contract_code_col"):
            self.combo_contract_code_col["values"] = col_names
            saved = saved_cols.get("contract_code_col", "")
            self.combo_contract_code_col.set(self.match_saved_column_name(saved, col_names))
        if hasattr(self, "combo_contract_name_col"):
            self.combo_contract_name_col["values"] = col_names
            saved = saved_cols.get("contract_name_col", "")
            self.combo_contract_name_col.set(self.match_saved_column_name(saved, col_names))
        if hasattr(self, "combo_dos_col"):
            self.combo_dos_col["values"] = col_names
