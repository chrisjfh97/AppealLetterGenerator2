                "subject", DEFAULT_BLURB_SUBJECT
            )
        return str(blurb_data), DEFAULT_BLURB_SUBJECT

    def get_row_blurb_payload(self, row):
        """Resolve the rationale body/subject for a specific dataframe row."""

        if self.auto_detect_blurb_var.get():
            if "RationaleName" not in self.df.columns:
                return None, None, "Missing RationaleName column"
            blurb_key = clean_text_value(row.get("RationaleName", ""))
            if not blurb_key:
                return None, None, "Missing RationaleName value"
            if blurb_key not in self.app_config["blurbs"]:
                return None, None, f"RationaleName '{blurb_key}' does not match an existing rationale"
            blurb_body, blurb_subject = self.get_blurb_payload(blurb_key)
            return blurb_body, blurb_subject, None

        blurb_key = self.combo_blurb.get() if hasattr(self, "combo_blurb") else "(None)"
        blurb_body, blurb_subject = self.get_blurb_payload(blurb_key)
        return blurb_body, blurb_subject, None

