def run_cli_config_set(args):
    """Update CLI-relevant shared settings."""

    try:
        app_config = load_saved_app_config()
    except Exception as exc:
        print(f"ERROR: Could not load config {CONFIG_FILE_PATH}: {exc}", file=sys.stderr)
        return 1

    changes = []
    if args.output is not None:
        app_config["output_path"] = args.output
        changes.append("output")
    if args.excel is not None:
        app_config["excel_path"] = args.excel
        changes.append("excel")
    if args.medical_records_folder is not None:
        app_config["medical_records_folder"] = args.medical_records_folder
        changes.append("medical-records-folder")
    if args.bot_path is not None:
        app_config["bot_network_path"] = args.bot_path
        changes.append("bot-path")
    if args.auto_detect_medical_records is not None:
        app_config["auto_detect_medical_records"] = args.auto_detect_medical_records == "on"
        changes.append("auto-detect-medical-records")
    if args.auto_send_notes_to_bot is not None:
        app_config["auto_send_notes_to_bot"] = args.auto_send_notes_to_bot == "on"
        changes.append("auto-send-notes-to-bot")
    if args.auto_detect_rationale is not None:
        app_config["auto_detect_blurb"] = args.auto_detect_rationale == "on"
        changes.append("auto-detect-rationale")
    if args.rationale is not None:
        app_config["selected_blurb"] = args.rationale
        app_config["auto_detect_blurb"] = False
        changes.append("rationale")
    if args.clear_rationale:
        app_config["selected_blurb"] = "(None)"
        changes.append("clear-rationale")

    if not changes:
        print("ERROR: Provide at least one config value to update.", file=sys.stderr)
        return 1

    app_config["fax_info"] = DEFAULT_FAX_INFO.copy()
    try:
        save_app_config(app_config)
    except Exception as exc:
        print(f"ERROR: Could not save config {CONFIG_FILE_PATH}: {exc}", file=sys.stderr)
        return 1

    print(f"Updated {', '.join(changes)} in {CONFIG_FILE_PATH}")
    return 0


def main(argv=None):
    """Route to GUI or CLI."""

    argv = sys.argv[1:] if argv is None else list(argv)
    if not argv:
        return launch_gui()
    parser = build_cli_parser()
    args = parser.parse_args(argv)
    if not hasattr(args, "handler"):
        parser.print_help()
        return 0
    return args.handler(args)
# --- Run the Application ---
if __name__ == "__main__":
    sys.exit(main())
