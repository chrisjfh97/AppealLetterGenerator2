    def get_column_signature(self, columns):
        """Build a stable key for a workbook layout based on its cleaned columns."""
        normalized = sorted(clean_column_name(col).lower() for col in columns)
        return "|".join(normalized)

    def save_current_special_col_profile(self):
        """Save required-column mappings for the currently loaded workbook layout."""
        if not getattr(self, "current_column_signature", ""):
            return
        selection = self.get_required_column_selection()
        if not any(selection.values()):
            return
        profiles = self.app_config.setdefault("special_col_profiles", {})
        profiles[self.current_column_signature] = selection.copy()

    def get_special_cols_for_current_profile(self):
        """Return saved required-column mappings for this workbook layout."""
        profiles = self.app_config.setdefault("special_col_profiles", {})
        return profiles.get(getattr(self, "current_column_signature", ""), {})

    def match_saved_column_name(self, saved_column, available_columns):
        """Match saved required-column names against current cleaned workbook columns."""
        if not saved_column:
            return ""
        if saved_column in available_columns:
            return saved_column
        normalized_saved = clean_column_name(saved_column).lower()
        for column in available_columns:
            if clean_column_name(column).lower() == normalized_saved:
                return column
        return ""

