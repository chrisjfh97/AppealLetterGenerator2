    def batch_duplicate_form_templates_from_excel(self, template_type, source_combo):
        """Duplicate one existing form template for many imported contracts."""
        if template_type != "form":
            messagebox.showerror(
                "Form Template Required",
                "Batch Duplicate Forms is only available for Form templates.",
            )
            return

        source_path = self._get_selected_form_duplicate_path(source_combo)
        source_label = source_combo.get().strip() if source_combo else ""
        if not source_path:
            messagebox.showerror(
                "Source Form Needed",
                "Select an existing form in Duplicate From Existing Form before running a batch duplicate.",
            )
            return
        if not os.path.exists(source_path):
            messagebox.showerror(
                "Source Form Missing",
                f"The selected source form could not be found:\n{source_path}",
            )
            return

        filepath = filedialog.askopenfilename(
            title="Import Contracts for Form Duplication",
            filetypes=[("Excel Files", "*.xlsx *.xls")],
            parent=self,
        )
        if not filepath:
            return

        try:
            df_import = pd.read_excel(filepath)
        except Exception as exc:
            messagebox.showerror(
                "Import Failed",
                f"Unable to read the Excel file:\n{exc}",
                parent=self,
            )
            return

        trimmed_columns = {str(col).strip(): col for col in df_import.columns}
        required_columns = ["Claim User Group", "Contract Code"]
        missing_columns = [col for col in required_columns if col not in trimmed_columns]
        if missing_columns:
            messagebox.showerror(
                "Missing Required Columns",
                "The Excel file must include columns named: Claim User Group, Contract Code.",
                parent=self,
            )
            return

        rows_to_create = []
        skipped_invalid = []
        for excel_index, row in df_import.iterrows():
            claim_value = row.get(trimmed_columns["Claim User Group"], "")
            contract_value = row.get(trimmed_columns["Contract Code"], "")
            claim_group = "" if pd.isna(claim_value) else str(claim_value).strip()
            contract_code = "" if pd.isna(contract_value) else str(contract_value).strip()
            row_label = f"Row {excel_index + 2}: {claim_group or '(blank)'} / {contract_code or '(blank)'}"

            if not claim_group or not contract_code:
                skipped_invalid.append(f"{row_label} - missing value")
                continue
            if INVALID_PATH_CHARS.search(claim_group) or INVALID_PATH_CHARS.search(contract_code):
                skipped_invalid.append(f"{row_label} - invalid filename character")
                continue

            target_filename = self.build_template_filename("form", claim_group, contract_code)
            if not target_filename:
                skipped_invalid.append(f"{row_label} - could not build filename")
                continue
            rows_to_create.append((claim_group, contract_code, target_filename, row_label))

        if not rows_to_create:
            messagebox.showinfo(
                "No Valid Contracts",
                "No valid rows were found to duplicate.",
                parent=self,
            )
            return

        if not messagebox.askyesno(
            "Confirm Batch Duplicate",
            (
                f"Duplicate source form:\n{source_label or Path(source_path).name}\n\n"
                f"Valid rows found: {len(rows_to_create)}\n\n"
                "Existing target forms will be skipped."
            ),
            parent=self,
        ):
            return

        template_map = self.get_template_mapping("form")
        created = []
        skipped_existing = []
        failed = []

        for _claim_group, _contract_code, target_filename, row_label in rows_to_create:
            copied_path, error = self.copy_template_to_expected_filename_no_prompt(
                "form", source_path, target_filename
            )
            if error == "exists":
                template_map[target_filename] = copied_path
                skipped_existing.append(f"{row_label} - already exists")
                continue
            if error:
                failed.append(f"{row_label} - {error}")
                continue
            template_map[target_filename] = copied_path
            created.append(target_filename)

        self.save_config()
        self.populate_template_listbox("form")
        self.refresh_form_duplicate_source_options()
        self.refresh_mapping_views()
        self.update_main_combos()

        summary_lines = [
            "Batch duplicate complete.",
            "",
            f"Created: {len(created)}",
            f"Skipped existing: {len(skipped_existing)}",
            f"Skipped invalid/incomplete: {len(skipped_invalid)}",
            f"Failed copy attempts: {len(failed)}",
        ]
        details = skipped_invalid + skipped_existing + failed
        if details:
            summary_lines.extend(["", "Details:"])
            summary_lines.extend(details[:12])
            if len(details) > 12:
                summary_lines.append(f"...and {len(details) - 12} more.")

        self.update_status_bar(
            f"Batch duplicated {len(created)} form template(s); skipped {len(skipped_existing) + len(skipped_invalid)}."
        )
        messagebox.showinfo(
            "Batch Duplicate Complete",
            "\n".join(summary_lines),
            parent=self,
        )

    def delete_template_item(
        self,
        template_type,
        claim_group_combo,
        contract_code_entry,
        generated_name_var,
        entry_path,
        type_combo,
        duplicate_source_combo=None,
    ):
        """Delete the selected template mapping entry."""
        listbox = self.template_listboxes.get(template_type)
        if not listbox:
            return
        selected_indices = listbox.curselection()
        selected_name = (
            self._get_template_listbox_key(listbox, listbox.get(selected_indices[0]))
            if selected_indices
            else generated_name_var.get().strip()
        )
        if not selected_name:
            messagebox.showerror("Error", "No template selected to delete.")
            return
        template_map = self.get_template_mapping(template_type)
        if selected_name in template_map:
            if messagebox.askyesno(
                "Confirm Delete", f"Remove '{selected_name}' from the template library?"
            ):
                del template_map[selected_name]
                self.save_config()
                self.populate_template_listbox(template_type)
                self.clear_template_editor(
                    claim_group_combo,
                    contract_code_entry,
                    generated_name_var,
                    entry_path,
                    type_combo,
                    duplicate_source_combo,
                )
                if template_type == "form":
                    self.refresh_form_duplicate_source_options()
                    self.refresh_mapping_views()
                self.update_main_combos()
                self.update_status_bar(
                    f"{template_type.capitalize()} template '{selected_name}' deleted."
