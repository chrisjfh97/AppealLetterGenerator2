    def start_send_to_bot_thread(self):
        """Confirm and start the worker that copies notes files to the network."""
        valid_files = [p for p in self.last_notes_file_paths if os.path.exists(p)]
        if not valid_files:
            messagebox.showerror("Error", "No notes files have been generated yet.")
            return
        if messagebox.askyesno(
            "Confirm Action",
            "Are you 100% sure you want to send all generated notes files to the bot?\n\n"
            f"Files: {len(valid_files)}\n\n"
            "This action cannot be reverted."
        ):
            self.set_buttons_state("disabled")
            self.q_print("Sending notes files to bot...")
            threading.Thread(target=self.run_send_to_bot, daemon=True).start()

    def run_send_to_bot(self, show_success_message=True, reset_buttons=True):
        """Copy generated notes files to the configured bot intake folder."""

        valid_files = [p for p in self.last_notes_file_paths if os.path.exists(p)]
        copied = 0
        failures = []
        self.last_send_to_bot_summary = {
            "copied": 0,
            "failed": 0,
            "failures": [],
            "ok": False,
        }
        try:
            destination = Path(self.bot_network_path)
            destination.mkdir(parents=True, exist_ok=True)
            for file_path in valid_files:
                try:
                    self._copy_file_flat_overwrite(file_path, destination)
                    copied += 1
                except Exception as exc:
                    failures.append(f"{Path(file_path).name}: {exc}")

            if failures:
                message = (
                    f"Copied {copied} notes file(s) to bot. "
                    f"{len(failures)} file(s) failed."
                )
                self.q_print(message)
                details = "\n".join(failures[:10])
                self.after(
                    0,
                    lambda: messagebox.showwarning(
                        "Send Completed With Failures",
                        f"{message}\n\n{details}",
                    ),
                )
                self.last_send_to_bot_summary = {
                    "copied": copied,
                    "failed": len(failures),
                    "failures": failures,
                    "ok": False,
                }
                return False
            else:
                message = f"Copied {copied} notes file(s) to bot."
                self.q_print(message)
                if show_success_message:
                    self.after(0, lambda: messagebox.showinfo("Send Complete", message))
                self.last_send_to_bot_summary = {
                    "copied": copied,
                    "failed": 0,
                    "failures": [],
                    "ok": True,
                }
                return True
        except Exception as exc:
            err_text = str(exc)
            self.q_print(f"Send to bot failed: {err_text}")
            self.after(
                0,
                lambda: messagebox.showerror(
                    "Send Failed",
                    f"Could not send notes files to the bot folder.\n\n{err_text}",
                ),
            )
            self.last_send_to_bot_summary = {
                "copied": copied,
                "failed": len(valid_files) - copied,
                "failures": [err_text],
                "ok": False,
            }
            return False
        finally:
            if reset_buttons:
                self.after(0, lambda: self.set_buttons_state("normal"))
