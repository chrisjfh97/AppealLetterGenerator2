        except Exception as e:
            error_msg = f"ERROR creating/rendering '{os.path.basename(save_path_base)}.docx' using template '{os.path.basename(template_path)}': {e}"
            self.q_print(error_msg)
            logging.error(error_msg, exc_info=True)
            import traceback
            traceback.print_exc()
