    def build_template_filename(self, template_type, claim_group, contract_code=""):
        """Build the exact filename expected by the template resolver."""
        claim_group = str(claim_group or "").strip()
        contract_code = str(contract_code or "").strip()
        if not claim_group:
            return ""
        if template_type == "letter":
            return f"{claim_group} - Letter template.docx"
        if template_type == "fax":
            return f"{claim_group} - Fax.docx"
        if template_type == "form":
            if not contract_code:
                return ""
            return f"{claim_group} - Form - {contract_code}.docx"
        return ""

    def parse_template_filename(self, template_type, filename):
        """Split a managed template filename back into editor fields."""
        name = Path(str(filename or "")).name
        if name.lower().endswith(".docx"):
            name = name[:-5]
        if template_type == "letter" and name.endswith(" - Letter template"):
            return name[:-18], ""
        if template_type == "fax" and name.endswith(" - Fax"):
            return name[:-6], ""
        if template_type == "form" and " - Form - " in name:
            claim_group, contract_code = name.split(" - Form - ", 1)
            return claim_group, contract_code
        return name, ""

    def validate_template_filename_parts(self, template_type, claim_group, contract_code):
        """Validate template filename fields before moving files."""
        claim_group = str(claim_group or "").strip()
        contract_code = str(contract_code or "").strip()
        if not claim_group:
            messagebox.showerror("Template Name Needed", "Claim User Group is required.")
            return False
        if template_type == "form" and not contract_code:
            messagebox.showerror("Template Name Needed", "Contract Code is required for form templates.")
            return False
        invalid_values = [claim_group]
        if template_type == "form":
            invalid_values.append(contract_code)
        for value in invalid_values:
            if INVALID_PATH_CHARS.search(value):
                messagebox.showerror(
                    "Invalid Filename",
                    "Template name fields cannot contain: \\ / : * ? \" < > |",
                )
                return False
        return True

    def move_template_to_expected_filename(self, template_type, template_path, target_filename):
        """Move and rename a template into the folder expected by generation."""
        if not template_path or not os.path.exists(template_path):
            messagebox.showerror(
                "Template File Needed",
                "Choose an existing .docx template file before saving.",
            )
            return None

        default_dir = Path(self.get_template_folder_path(template_type))
        target_path = default_dir / target_filename
        source_path = Path(template_path)
        try:
            default_dir.mkdir(parents=True, exist_ok=True)
            if source_path.resolve() == target_path.resolve():
                return str(target_path)
            if target_path.exists():
                should_replace = messagebox.askyesno(
                    "Replace Existing Template",
                    f"A template already exists with this name:\n{target_path}\n\nReplace it?",
                )
                if not should_replace:
                    return None
                target_path.unlink()
            shutil.move(str(source_path), str(target_path))
            return str(target_path)
        except Exception as exc:
            messagebox.showwarning(
                "Template Save Failed",
                f"Unable to move and rename template:\n{exc}",
            )
            return None

    def copy_template_to_expected_filename(self, template_type, template_path, target_filename):
        """Copy a template into the expected template folder without moving the source."""
        if not template_path or not os.path.exists(template_path):
            messagebox.showerror(
                "Template File Needed",
                "Choose an existing .docx template file before duplicating.",
            )
            return None

        default_dir = Path(self.get_template_folder_path(template_type))
        target_path = default_dir / target_filename
        source_path = Path(template_path)
        try:
            default_dir.mkdir(parents=True, exist_ok=True)
            if source_path.resolve() == target_path.resolve():
                messagebox.showerror(
                    "Duplicate Target Needed",
                    "Change the Claim User Group or Contract Code so the duplicate has a different generated filename.",
                )
                return None
            if target_path.exists():
                should_replace = messagebox.askyesno(
                    "Replace Existing Template",
                    f"A template already exists with this name:\n{target_path}\n\nReplace it?",
                )
                if not should_replace:
                    return None
                target_path.unlink()
            shutil.copy2(str(source_path), str(target_path))
            return str(target_path)
        except Exception as exc:
            messagebox.showwarning(
                "Template Duplicate Failed",
                f"Unable to duplicate template:\n{exc}",
            )
            return None

    def copy_template_to_expected_filename_no_prompt(self, template_type, template_path, target_filename):
        """Copy a template into the expected folder, skipping existing targets."""
        if not template_path or not os.path.exists(template_path):
            return None, "Source template file was not found"

        default_dir = Path(self.get_template_folder_path(template_type))
        target_path = default_dir / target_filename
        source_path = Path(template_path)
        try:
            default_dir.mkdir(parents=True, exist_ok=True)
            if target_path.exists():
                return str(target_path), "exists"
            if source_path.resolve() == target_path.resolve():
                return None, "Source and target are the same file"
            shutil.copy2(str(source_path), str(target_path))
            return str(target_path), ""
        except Exception as exc:
            return None, str(exc)

    def load_template_item(self, event, template_type):
        """Load a template mapping into the editor widgets."""
        try:
            selected_index = event.widget.curselection()[0]
            selected_display = event.widget.get(selected_index)
            selected_name = self._get_template_listbox_key(event.widget, selected_display)
        except IndexError:
            return
        if not hasattr(self, "template_editor_fields"):
            return

        template_map = self.get_template_mapping(template_type)
        (
            claim_group_combo,
            contract_code_entry,
            generated_name_var,
            entry_path,
            type_combo,
            refresh_generated_name,
            duplicate_source_combo,
        ) = self.template_editor_fields

        claim_group, contract_code = self.parse_template_filename(template_type, selected_name)
        type_combo.set(template_type.capitalize())
        claim_group_combo.delete(0, tk.END)
        claim_group_combo.insert(0, claim_group)
        contract_code_entry.configure(state=tk.NORMAL)
        contract_code_entry.delete(0, tk.END)
        contract_code_entry.insert(0, contract_code)
        entry_path.delete(0, tk.END)
        entry_path.insert(0, template_map.get(selected_name, ""))
        duplicate_source_combo.set("")
        refresh_generated_name()
        if not generated_name_var.get() and selected_name:
            generated_name_var.set(selected_name)

    def save_template_item(
        self,
        template_type,
        claim_group_combo,
        contract_code_entry,
        generated_name_var,
        entry_path,
    ):
        """Persist a template mapping and normalize the template filename."""
        claim_group = claim_group_combo.get().strip()
        contract_code = contract_code_entry.get().strip()
        if not self.validate_template_filename_parts(template_type, claim_group, contract_code):
            return

        item_name = self.build_template_filename(template_type, claim_group, contract_code)
        generated_name_var.set(item_name)
        item_path = entry_path.get().strip()
        moved_path = self.move_template_to_expected_filename(template_type, item_path, item_name)
        if not moved_path:
            return

        entry_path.delete(0, tk.END)
        entry_path.insert(0, moved_path)
        template_map = self.get_template_mapping(template_type)
        stale_keys = [
            key for key, path in template_map.items()
            if path == item_path and key != item_name
        ]
        for key in stale_keys:
            del template_map[key]
        template_map[item_name] = moved_path
        self.save_config()
        listbox = self.template_listboxes.get(template_type)
        if listbox:
            self.populate_template_listbox(template_type)
            self.select_template_listbox_item(template_type, item_name)
        if template_type == "form":
            self.refresh_form_duplicate_source_options()
            self.refresh_mapping_views()
        self.update_main_combos()
        self.update_status_bar(
            f"{template_type.capitalize()} template '{item_name}' saved."
        )

