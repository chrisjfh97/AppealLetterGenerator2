    def export_mapping_rows(self):
        """Export the currently visible method mapping table to CSV or Excel."""

        mapping_rows = self.app_config.get("mapping_rows", [])
        visible_indexes = getattr(self, "mapping_visible_indexes", [])
        export_rows = [
            {col: mapping_rows[index].get(col, "") for col in self.mapping_columns}
            for index in visible_indexes
            if 0 <= index < len(mapping_rows)
        ]
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filepath = filedialog.asksaveasfilename(
            title="Export Method Mapping",
            defaultextension=".xlsx",
            initialfile=f"method_mapping_{timestamp}.xlsx",
            filetypes=[("Excel Workbook", "*.xlsx"), ("CSV File", "*.csv")],
            parent=self,
        )
        if not filepath:
            return

        try:
            export_path = Path(filepath)
            if not export_path.suffix:
                export_path = export_path.with_suffix(".xlsx")
            df_map = pd.DataFrame(export_rows, columns=self.mapping_columns)
            if export_path.suffix.lower() == ".csv":
                df_map.to_csv(export_path, index=False, encoding="utf-8-sig")
            else:
                df_map.to_excel(export_path, index=False)
            self.update_status_bar(
