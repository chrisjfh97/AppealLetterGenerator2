    def create_and_save_doc(self, template_path, save_path_base, merge_data):
        """Uses docxtpl to render and save a .docx file."""
        try:
            doc = DocxTemplate(template_path)
            context = merge_data
            doc.render(context)
            docx_final_path = save_path_base + ".docx"
            doc.save(docx_final_path)
            return docx_final_path
        except Exception as e:
            error_msg = f"ERROR creating/rendering '{os.path.basename(save_path_base)}.docx' using template '{os.path.basename(template_path)}': {e}"
            self.q_print(error_msg)
            logging.error(error_msg, exc_info=True)
            import traceback
            traceback.print_exc()
            return None


