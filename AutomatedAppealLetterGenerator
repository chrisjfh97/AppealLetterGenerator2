    def refresh_mapping_views(self):
        """Refresh mapping and acronym trees from config state."""
        if hasattr(self, "mapping_tree"):
            for item in self.mapping_tree.get_children():
                self.mapping_tree.delete(item)
            mapping_rows = self.app_config.get("mapping_rows", [])
            self.refresh_mapping_filter_options(mapping_rows)
            self.mapping_visible_indexes = []
            visible_rows = []
            display_rows = []
            for stored_index, row in enumerate(mapping_rows):
                if not self.mapping_row_matches_filters(row):
                    continue
                row_index = len(visible_rows)
                visible_rows.append(row)
                self.mapping_visible_indexes.append(stored_index)
                display_row = {
                    col: row.get(col, "") for col in self.mapping_columns
                }
                display_row["Form Setup"] = (
