def deep_update_config(source, overrides):
    """Merge nested config values into source and return source."""

    for key, value in overrides.items():
        if (
            isinstance(value, dict)
            and key in source
            and isinstance(source[key], dict)
        ):
            deep_update_config(source[key], value)
        else:
            source[key] = value
    return source


def apply_legacy_config_migrations(app_config, loaded_config):
    """Normalize legacy config keys after loading saved JSON."""

    templates = app_config.get("templates")
    if not isinstance(templates, dict):
        templates = {"letter": {}, "fax": {}, "form": {}}
        app_config["templates"] = templates
    for template_type in ("letter", "fax", "form"):
        if not isinstance(templates.get(template_type), dict):
            templates[template_type] = {}
    legacy_template_paths = {
        "letter": loaded_config.get("letter_template_path", ""),
        "fax": loaded_config.get("fax_template_path", ""),
    }
    for template_type, legacy_path in legacy_template_paths.items():
        if legacy_path and os.path.exists(legacy_path):
            base_name = Path(legacy_path).stem
            template_map = templates.setdefault(template_type, {})
            if base_name not in template_map:
                template_map[base_name] = legacy_path

    for legacy_key in (
        "letter_template_path",
        "fax_template_path",
        "form_templates",
        "selected_templates",
        "payer_contacts",
        "addresses",
        "cm_headings",
    ):
        app_config.pop(legacy_key, None)


def load_saved_app_config(base_config=None):
