                    text_widget.insert(tk.END, text[position:match.start()], "code")
                text_widget.insert(tk.END, match.group(0), ("code", "column"))
                position = match.end()
            if position < len(text):
                text_widget.insert(tk.END, text[position:], "code")
            text_widget.insert(tk.END, "\n", "code")

