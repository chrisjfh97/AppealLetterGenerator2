    def autosize_tree_columns(self, tree, columns, rows=None, min_width=90, max_width=420):
        """Size Treeview columns from header and row text widths."""

        font = tkfont.nametofont("TkDefaultFont")
        rows = rows or []
        for col in columns:
            width = font.measure(str(col)) + 28
            for row in rows:
                if isinstance(row, dict):
                    value = row.get(col, "")
                else:
                    try:
                        value = row[columns.index(col)]
                    except (IndexError, TypeError, ValueError):
                        value = ""
                for line in str(value).splitlines() or [""]:
                    width = max(width, font.measure(line) + 28)
            width = min(max(width, min_width), max_width)
            tree.column(col, width=width, minwidth=min_width, stretch=True)

