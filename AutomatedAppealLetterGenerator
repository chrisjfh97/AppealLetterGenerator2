    def _get_column_format_grid_count(self, width=None):
        """Choose how many format-control columns can fit in the current tab."""

        if width is None:
            width = self.col_config_canvas.winfo_width() if hasattr(self, "col_config_canvas") else 0
        if width <= 1:
            width = max(1, self.winfo_width() - 60)
        return max(1, min(4, width // 340))

    def _sync_column_format_widgets_to_config(self):
        """Keep in-memory column format choices before rebuilding the grid."""

        for col, widgets in getattr(self, "column_widgets", {}).items():
            combo = widgets.get("combo")
            if combo is not None:
                self.app_config["column_formats"][col] = combo.get()

    def _on_column_format_canvas_configure(self, event):
        """Resize the scrollable frame and reflow controls when width changes."""

        if hasattr(self, "col_config_window_id"):
            self.col_config_canvas.itemconfigure(self.col_config_window_id, width=event.width)
        if self.df is None or not hasattr(self, "col_config_scrollable_frame"):
            return
        new_count = self._get_column_format_grid_count(event.width)
        if new_count == getattr(self, "column_format_grid_columns", None):
            return
        pending_relayout = getattr(self, "_column_format_relayout_after", None)
        if pending_relayout:
            try:
                self.after_cancel(pending_relayout)
            except tk.TclError:
                pass

        def reflow():
            self._column_format_relayout_after = None
            self._render_column_format_controls(new_count)

        self._column_format_relayout_after = self.after(120, reflow)

    def _render_column_format_controls(self, grid_columns=None):
        """Lay out Excel column format controls in a wrapped grid."""

        self._sync_column_format_widgets_to_config()
        for widget in self.col_config_scrollable_frame.winfo_children():
            widget.destroy()
        self.column_widgets.clear()
        if self.df is None:
            ttk.Label(
                self.col_config_scrollable_frame, text="Load an Excel file first."
            ).pack(pady=20)
            return

        format_options = [
            "Text",
            "Date (MM/DD/YYYY)",
            "Monetary ($#,##.##)",
            "Percentage (##.##%)",
        ]
        grid_columns = grid_columns or self._get_column_format_grid_count()
        self.column_format_grid_columns = grid_columns
        for grid_col in range(grid_columns):
            self.col_config_scrollable_frame.columnconfigure(grid_col, weight=1, uniform="format_col")

        for i, col in enumerate(self.df.columns):
            row_index = i // grid_columns
            col_index = i % grid_columns
            item_frame = ttk.Frame(self.col_config_scrollable_frame, padding=(5, 2))
            item_frame.grid(row=row_index, column=col_index, sticky=tk.EW, padx=4, pady=2)
            item_frame.columnconfigure(0, weight=1)
            lbl = ttk.Label(
                item_frame, text=col, anchor=tk.W, relief="groove", padding=2
            )
            lbl.grid(row=0, column=0, sticky=tk.EW)
            combo = ttk.Combobox(
                item_frame, values=format_options, state="readonly", width=22
            )
            combo.grid(row=0, column=1, padx=(5, 0), sticky=tk.EW)
            saved_format = self.app_config["column_formats"].get(col, "Text")
            combo.set(saved_format if saved_format in format_options else "Text")
            combo.bind("<<ComboboxSelected>>", self.save_config)
            self.column_widgets[col] = {"label": lbl, "combo": combo}

