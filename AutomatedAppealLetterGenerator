        with open(CONFIG_FILE_PATH, "r", encoding="utf-8") as f:
            loaded_config = json.load(f)
        deep_update_config(app_config, loaded_config)
        apply_legacy_config_migrations(app_config, loaded_config)
    return app_config


def save_app_config(app_config):
