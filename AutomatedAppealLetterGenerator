    def refresh_mapping_filter_options(self, mapping_rows):
        """Refresh Client Mapping filter values from current mapping rows."""

        if not hasattr(self, "mapping_claim_filter_combo"):
            return
        claim_values = sorted(
            {
                clean_text_value(row.get("Claim User Group", ""))
                for row in mapping_rows
                if clean_text_value(row.get("Claim User Group", ""))
            }
        )
        contract_values = sorted(
            {
                clean_text_value(row.get("Contract Code", ""))
                for row in mapping_rows
                if clean_text_value(row.get("Contract Code", ""))
            }
        )
        payer_values = sorted(
            {
                clean_text_value(row.get("Payer Name", ""))
                for row in mapping_rows
                if clean_text_value(row.get("Payer Name", ""))
            }
        )
        claim_options = ["(All)"] + claim_values
        contract_options = ["(All)"] + contract_values
        payer_options = ["(All)"] + payer_values
        self.mapping_claim_filter_combo["values"] = claim_options
        self.mapping_contract_filter_combo["values"] = contract_options
        self.mapping_payer_filter_combo["values"] = payer_options
        if self.mapping_claim_filter_var.get() not in claim_options:
            self.mapping_claim_filter_var.set("(All)")
        if self.mapping_contract_filter_var.get() not in contract_options:
            self.mapping_contract_filter_var.set("(All)")
        if self.mapping_payer_filter_var.get() not in payer_options:
            self.mapping_payer_filter_var.set("(All)")

    def mapping_row_matches_filters(self, row):
        """Return True when a mapping row passes the active filters."""

        claim_filter = self.mapping_claim_filter_var.get() if hasattr(self, "mapping_claim_filter_var") else "(All)"
        contract_filter = self.mapping_contract_filter_var.get() if hasattr(self, "mapping_contract_filter_var") else "(All)"
        payer_filter = self.mapping_payer_filter_var.get() if hasattr(self, "mapping_payer_filter_var") else "(All)"
        method_filter = self.mapping_method_filter_var.get() if hasattr(self, "mapping_method_filter_var") else "(All)"
        form_filter = self.mapping_form_filter_var.get() if hasattr(self, "mapping_form_filter_var") else "(All)"
        form_setup_filter = (
            self.mapping_form_setup_filter_var.get()
            if hasattr(self, "mapping_form_setup_filter_var")
            else "(All)"
        )
        search_text = self.mapping_search_var.get().strip().lower() if hasattr(self, "mapping_search_var") else ""
        if claim_filter != "(All)" and clean_text_value(row.get("Claim User Group", "")) != claim_filter:
            return False
        if contract_filter != "(All)" and clean_text_value(row.get("Contract Code", "")) != contract_filter:
            return False
        if payer_filter != "(All)" and clean_text_value(row.get("Payer Name", "")) != payer_filter:
            return False
        if method_filter != "(All)":
            method_to_use = clean_text_value(row.get("MethodToUse", ""))
            selected_type = clean_text_value(row.get(f"Method {method_to_use} Type", ""))
            if selected_type.lower() != method_filter.lower():
                return False
        if form_filter != "(All)":
            requires_form = "Yes" if self._mapping_requires_form(row) else "No"
            if requires_form != form_filter:
                return False
        if form_setup_filter != "(All)":
            needs_setup = self.mapping_needs_form_setup(row)
            if form_setup_filter == "Needs Setup" and not needs_setup:
                return False
            if form_setup_filter == "Ready / Not Required" and needs_setup:
                return False
        if search_text:
            searchable = " ".join(clean_text_value(row.get(col, "")) for col in self.mapping_columns).lower()
            if search_text not in searchable:
                return False
        return True

