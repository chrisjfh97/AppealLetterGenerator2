            "copied": 0,
            "failed": 0,
            "failures": [],
            "ok": False,
        }
        self.auto_send_notes_to_bot_enabled_for_run = False

        self.enforce_fax_info_defaults()
        self.normalize_blurb_config()
        self.normalize_template_config()

        special_cols = self.app_config.setdefault("special_cols", {})
