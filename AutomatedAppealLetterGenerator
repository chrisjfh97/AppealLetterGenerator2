    def find_template_by_expected_filename(self, template_type, target_filename):
        """Find a managed template by expected filename in config or default folder."""
        if not target_filename:
            return ""
        default_dir = Path(self.get_template_folder_path(template_type))
        candidate = default_dir / target_filename
        if candidate.exists():
            return str(candidate)
        target_name = target_filename.lower()
        for path in self.get_template_mapping(template_type).values():
            if path and Path(path).name.lower() == target_name and os.path.exists(path):
                return path
        return ""

    def find_managed_template_by_expected_filename(self, template_type, target_filename):
        """Find a registered template whose configured file still exists."""
        if not target_filename:
            return ""
        target_name = target_filename.lower()
        template_map = self.get_template_mapping(template_type)
        configured_path = template_map.get(target_filename, "")
        if configured_path and os.path.exists(configured_path):
            return configured_path
        for path in template_map.values():
            if path and Path(path).name.lower() == target_name and os.path.exists(path):
                return path
        return ""

    def get_expected_form_template_name_for_mapping(self, row):
        """Build the expected form template filename for a mapping row."""
        return self.build_template_filename(
            "form",
            row.get("Claim User Group", ""),
            row.get("Contract Code", ""),
        )

    def mapping_needs_form_setup(self, row):
        """Return True when a required form template is not configured yet."""
        if not self._mapping_requires_form(row):
            return False
        expected_name = self.get_expected_form_template_name_for_mapping(row)
        if not expected_name:
            return False
        return not bool(self.find_managed_template_by_expected_filename("form", expected_name))

    def handle_mapping_table_click(self, event):
        """Open template setup from the UI-only Form Setup table column."""
        tree = getattr(self, "mapping_tree", None)
        if not tree:
            return
        if tree.identify("region", event.x, event.y) != "cell":
            return
        column_id = tree.identify_column(event.x)
        setup_column = f"#{self.mapping_display_columns.index('Form Setup') + 1}"
        if column_id != setup_column:
            return
        row_id = tree.identify_row(event.y)
        if not row_id:
            return
        visible_idx = tree.index(row_id)
        if not (0 <= visible_idx < len(getattr(self, "mapping_visible_indexes", []))):
            return
        stored_idx = self.mapping_visible_indexes[visible_idx]
        rows = self.app_config.get("mapping_rows", [])
        if not (0 <= stored_idx < len(rows)):
            return
        row = rows[stored_idx]
        if self.mapping_needs_form_setup(row):
            self.open_form_template_setup_from_mapping(row)

    def handle_mapping_table_double_click(self, event):
        """Edit rows on double-click except when the setup action column was hit."""
        tree = getattr(self, "mapping_tree", None)
        if tree and tree.identify("region", event.x, event.y) == "cell":
            column_id = tree.identify_column(event.x)
            setup_column = f"#{self.mapping_display_columns.index('Form Setup') + 1}"
            if column_id == setup_column:
                return "break"
        self.edit_mapping_row(edit=True)

    def open_form_template_setup_from_mapping(self, row):
        """Open Templates with a form target prefilled from a mapping row."""
        if not hasattr(self, "template_editor_fields"):
