    def validate_template_fields(self, template_path):
        """Checks template fields against Excel columns using docxtpl."""
        self.q_print(f"Validating template: {os.path.basename(template_path)}...")
        if not os.path.exists(template_path):
            messagebox.showerror("Error", f"Template file not found:\n{template_path}")
            return {"__TEMPLATE_NOT_FOUND__"}
        try:
            doc = DocxTemplate(template_path)
            template_fields = (
                doc.get_undeclared_template_variables()
            )
            if self.df is None:
                messagebox.showerror(
                    "Error",
                    "Cannot validate template because Excel file is not loaded.",
                )
                return {"__EXCEL_NOT_LOADED__"}
            excel_cols = set(self.df.columns)
            allowed_non_excel_fields = {
                "TodayDate",
                "AddressBlock",
                "BlurbBlock",
                "SubjectBlock",
                "total_pages",
                "FileDate",
                "Acronym",
                "Patient_FirstName",
                "Patient_LastName",
            }
            allowed_non_excel_fields.update(
                self.app_config["fax_info"].keys()
            )
            allowed_non_excel_fields.update(
                ["payer_name", "payer_fax", "payer_attn"]
            )
            missing_fields = template_fields - excel_cols - allowed_non_excel_fields
            return missing_fields
        except Exception as e:
            self.q_print(
                f"Error validating template '{os.path.basename(template_path)}': {e}"
            )
            messagebox.showwarning(
                "Template Warning",
                f"Could not validate template {os.path.basename(template_path)}.\nError: {e}",
            )
            return set()

    def validate_blurb_placeholders(self, blurb_text, blurb_name):
        """Ensure rationale placeholders exist in the loaded Excel columns."""
        if not blurb_text:
            return set()
        if self.df is None:
            messagebox.showerror(
                "Rationale Validation Failed",
                "Cannot validate rationale placeholders because Excel is not loaded.",
            )
            return {"__EXCEL_NOT_LOADED__"}
        try:
            env = Environment()
            parsed = env.parse(blurb_text)
            env.from_string(blurb_text)
            placeholders = meta.find_undeclared_variables(parsed)
        except Exception as exc:
            messagebox.showerror(
                "Rationale Validation Failed",
                f"Unable to parse the rationale '{blurb_name}'.\n\nDetails: {exc}",
            )
            return {"__BLURB_PARSE_ERROR__"}
        allowed = set(self.df.columns)
        allowed.update({"Patient_FirstName", "Patient_LastName"})
        missing = placeholders - allowed
        if missing:
            messagebox.showerror(
                "Rationale Validation Failed",
                (
                    f"The rationale '{blurb_name}' contains placeholders that are not "
                    "available from the Excel file.\n\n"
                    f"Missing placeholders:\n• {', '.join(sorted(missing))}"
                ),
            )
        return missing

    def validate_selected_rationales_before_generation(self):
        """Validate selected/generated rationales once before row generation starts."""

        rationales_to_validate = {}
        missing_rationales = set()

        if self.auto_detect_blurb_var.get():
            if self.df is None or "RationaleName" not in self.df.columns:
                return False
            for value in self.df["RationaleName"]:
                blurb_key = clean_text_value(value)
                if not blurb_key:
                    continue
                if blurb_key not in self.app_config["blurbs"]:
                    missing_rationales.add(blurb_key)
                    continue
                rationales_to_validate[blurb_key] = self.get_blurb_payload(blurb_key)[0]
        else:
            blurb_key = self.combo_blurb.get() if hasattr(self, "combo_blurb") else "(None)"
            if blurb_key and blurb_key != "(None)":
                rationales_to_validate[blurb_key] = self.get_blurb_payload(blurb_key)[0]

        if missing_rationales:
            missing_list = "\n- ".join(sorted(missing_rationales))
            messagebox.showerror(
                "Rationale Validation Failed",
                (
                    "Generation cannot start because the Excel file references "
                    "rationales that do not exist.\n\n"
                    f"Missing rationales:\n- {missing_list}"
                ),
            )
            return False

        for blurb_name, blurb_text in rationales_to_validate.items():
            if self.validate_blurb_placeholders(blurb_text, blurb_name):
                return False

        return True
