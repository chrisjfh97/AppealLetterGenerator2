    def _mapping_requires_form(self, mapping_row):
        """Return whether the mapping row's Form? flag is truthy."""

        return str(mapping_row.get("Form?", "")).strip().lower() in {"true", "1", "yes", "y"}

    def _resolve_required_templates(self, ugid, contract_code, needs_form, needs_fax):
        def find_template(template_type, target_filename):
            default_dir = Path(self.get_template_folder_path(template_type))
            candidate = default_dir / target_filename
            if candidate.exists():
                return str(candidate)
            for path in self.get_template_mapping(template_type).values():
                if Path(path).name.lower() == target_filename.lower() and Path(path).exists():
                    return path
            return ""

        letter_path = find_template("letter", f"{ugid} - Letter template.docx")
        if not letter_path or not os.path.exists(letter_path):
            return None, None, None, "Letter template missing"
        form_path = None
        if needs_form:
            form_path = find_template("form", f"{ugid} - Form - {contract_code}.docx")
            if not form_path or not os.path.exists(form_path):
                return None, None, None, "Form template missing"
        fax_path = None
        if needs_fax:
            fax_path = find_template("fax", f"{ugid} - Fax.docx")
            if not fax_path or not os.path.exists(fax_path):
                return None, None, None, "Fax template missing"
        return letter_path, form_path, fax_path, None

    def _get_template_render_error(self, template_path, context, label):
        """Return a render error message without writing an output file."""

        try:
            doc = DocxTemplate(template_path)
            doc.render(context)
            return None
        except Exception as exc:
            template_name = os.path.basename(template_path) if template_path else label
            return f"{label} template render error ({template_name}): {exc}"

    def preflight_generation_requirements(self, row_groups):
        """Validate all rows before creating any generation output folders."""

        failures = []
        group_configs = {}

        for (ugid, contract_code), group_rows in row_groups:
            group_error = None
            mapping_row = None
            method_type = None
            method_contact = ""
            form_flag = False
            letter_template = None
            form_template = None
            fax_template = None
            mailing_folder = ""

            if not ugid or not contract_code:
                group_error = "Mapping not found"
            else:
                mapping_row = self._lookup_mapping_row(ugid, contract_code)
                if not mapping_row:
                    group_error = "Mapping not found"
                else:
                    method_type, method_contact, method_err = self._parse_selected_method(mapping_row)
                    if method_err:
                        group_error = method_err
                    else:
                        form_flag = self._mapping_requires_form(mapping_row)
                        needs_fax = method_type == "Fax" and not form_flag
                        letter_template, form_template, fax_template, template_err = self._resolve_required_templates(
                            ugid,
                            contract_code,
                            form_flag,
                            needs_fax,
                        )
                        if template_err:
                            group_error = template_err
                        else:
                            mailing_folder = self._find_mailing_folder(ugid)
                            if method_type == "Mail" and not mailing_folder:
                                group_error = "Missing Mailing Folder for Claim User Group"

            if group_error:
                for index, _ in group_rows:
                    failures.append((index, group_error))
                continue

            payer_name = clean_text_value(mapping_row.get("Payer Name", ""))
            payer_attn = clean_text_value(mapping_row.get("Attention To", ""))
            address_block = build_contact_address_block(
                payer_name, payer_attn, method_type, method_contact
            )
            acronym = self._find_acronym(ugid)

            for index, row in group_rows:
                row_data = self.format_row_data(row)
                blurb_body, blurb_subject, blurb_err = self.get_row_blurb_payload(row)
                if blurb_err:
                    failures.append((index, blurb_err))
                    continue

                context = self.build_letter_merge_dict(row_data, blurb_body, blurb_subject)
                context["AddressBlock"] = address_block
                context["payer_name"] = payer_name
                context["payer_fax"] = method_contact if method_type == "Fax" else ""
                context["payer_attn"] = payer_attn
                context["Acronym"] = acronym

                render_checks = [("Letter", letter_template, context)]
                if form_flag:
                    render_checks.append(("Form", form_template, context))
                if fax_template:
                    fax_context = dict(context)
                    fax_context["total_pages"] = 1
                    render_checks.append(("Fax coversheet", fax_template, fax_context))

                for label, template_path, render_context in render_checks:
                    render_err = self._get_template_render_error(template_path, render_context, label)
                    if render_err:
                        failures.append((index, render_err))
                        break

            group_configs[(ugid, contract_code)] = {
                "mapping_row": mapping_row,
                "method_type": method_type,
                "method_contact": method_contact,
                "form_flag": form_flag,
                "letter_template": letter_template,
                "form_template": form_template,
                "fax_template": fax_template,
                "mailing_folder": mailing_folder,
            }

        return group_configs, failures

    def _get_appeal_page_count(self, generated_paths, include_cover=False):
        """Count pages for documents that belong to the appeal, excluding fax covers."""

        total_pages = 0
        for file_path in generated_paths:
            if file_path and os.path.exists(file_path):
                file_name = Path(file_path).name.lower()
                if ".fax" in file_name:
                    continue
                page_count = self._get_file_page_count(file_path)
                if page_count > 0:
                    total_pages += page_count
        if include_cover:
            total_pages += 1
        return max(1, total_pages)

    def _get_account_folder_page_count(self, account_folder, include_cover=False):
        """Count appeal pages in an account folder using the legacy fax logic."""

        total_pages = 0
        folder = Path(account_folder)
        if folder.exists() and folder.is_dir():
            for file_path in folder.iterdir():
                if not file_path.is_file() or file_path.name.startswith("~$"):
                    continue
                if ".fax" in file_path.name.lower():
                    continue
                page_count = self._get_file_page_count(file_path)
                if page_count > 0:
                    total_pages += page_count
        if include_cover:
            total_pages += 1
        return max(1, total_pages)

    def _get_file_page_count(self, file_path):
        """Return a best-effort page count for generated appeal attachments."""

        suffix = Path(file_path).suffix.lower()
        if suffix == ".docx":
            return get_docx_page_count(file_path)
        if suffix == ".pdf":
            return get_pdf_page_count(file_path)
        return 0

