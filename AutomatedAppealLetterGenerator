    def configure_window_geometry(self):
        """Set an initial window size that adapts to the user's screen."""
        self.update_idletasks()
        screen_w = max(1, self.winfo_screenwidth())
        screen_h = max(1, self.winfo_screenheight())

        def target_size(target, minimum, screen, margin):
            usable = max(minimum, screen - margin)
            size = min(target, usable, screen)
            return max(minimum if screen >= minimum else screen, size)

        min_width = min(900, max(640, screen_w - 160))
        min_height = min(700, max(540, screen_h - 160))
        width = target_size(min_width, min_width, screen_w, margin=80)
        height = target_size(min_height, min_height, screen_h, margin=80)
        x = max(0, (screen_w - width) // 2)
        y = max(0, (screen_h - height) // 2)
        self.geometry(f"{width}x{height}+{x}+{y}")
        self.minsize(
            min_width if screen_w >= min_width else screen_w,
            min_height if screen_h >= min_height else screen_h,
        )

    def register_grid_weights(self, widget, weights):
        """Queue grid weight configurations for later application."""
        if widget is None or not weights:
            return
        self._grid_weights.append((widget, dict(weights)))

    def configure_weighted_grid(self):
        """Apply stored grid weight configurations to make layouts responsive."""
        seen = {}
        for widget, weights in self._grid_weights:
            if widget in seen:
                seen[widget].update(weights)
            else:
                seen[widget] = dict(weights)
        for widget, weights in seen.items():
            for column, weight in weights.items():
                widget.columnconfigure(column, weight=weight)

