        self._grid_weights = []
        self.mapping_visible_indexes = []
        self.current_task_total = 0
        self.current_task_completed = 0
        self.cancel_requested = False
        self.fatal_error = False
        self.today_date_str = datetime.now().strftime("%B %d, %Y")
        self.file_date_str = datetime.now().strftime("%m%d%y")
        self.user_info_data = DEFAULT_FAX_INFO.copy()
        self.selected_payer_data = {}
        self.selected_address = ""
        self.bot_network_path = self.app_config.get("bot_network_path", BOT_NETWORK_PATH)
        self.last_notes_file_paths = []
        self.last_successful_items = []
        self.last_generation_summary = {"success": 0, "failed": 0, "message": ""}
