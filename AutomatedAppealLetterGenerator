# --- Page Counting Functions ---
def get_docx_page_count(docx_fpath):
    """Uses zipfile and regex to get the page count from a .docx file."""
    try:
        with zipfile.ZipFile(docx_fpath) as docx_object:
            docx_property_file_data = docx_object.read("docProps/app.xml").decode()
            match = re.search(r"<Pages>(\d+)</Pages>", docx_property_file_data)
            if match:
                return int(match.group(1))
            else:
                match = re.search(r"<Words>(\d+)</Words>", docx_property_file_data)
                if match and int(match.group(1)) > 0:
                    return 1
                return 0
    except Exception as e:
        logging.error(f"Error counting DOCX pages for {docx_fpath}: {e}",exc_info=True)
        return 0
def get_pdf_page_count(pdf_fpath):
    """Uses PyMuPDF (fitz) to get the page count from a .pdf file."""
    try:
        with fitz.open(pdf_fpath) as doc:
            count = doc.page_count
        return count
    except Exception as e:
        logging.error(f"Error counting PDF pages for {pdf_fpath}: {e}",exc_info=True)
        return 0
# --- Helper Function for Cleaning Column Names ---
def clean_column_name(col_name):
    """Replaces spaces and invalid characters with underscores."""
    col_name = str(col_name)
    chars_to_replace = r"[ /\\()#?*-]"
    cleaned_name = re.sub(chars_to_replace, "_", col_name)
    cleaned_name = re.sub(r"_+", "_", cleaned_name).strip("_")
    return cleaned_name


def format_value(value, format_type):
    """Format a raw value based on the configured column type."""

    try:
        if pd.isna(value):
            return ""
        if format_type == "Text":
            if isinstance(value, float) and value.is_integer():
                return str(int(value))
            return str(value)
        if format_type == "Date (MM/DD/YYYY)":
            return pd.to_datetime(value).strftime("%m/%d/%Y")
        if format_type == "Number (Int)":
            return f"{float(value):.0f}"
        if format_type == "Number (Float - 2 decimals)":
            return f"{float(value):.2f}"
        if format_type in {"Currency ($#,##.##)", "Monetary ($#,##.##)"}:
            return f"${float(value):,.2f}"
        if format_type == "Percentage (##.##%)":
            return f"{float(value):.2f}%"
    except ValueError:
        logging.warning(
            "Warning: Could not apply format '%s' to value '%s'. Using raw string.",
            format_type,
            value,
        )
    except Exception as exc:
        logging.warning(
            "Warning: Unexpected error formatting value '%s' with format '%s': %s",
            value,
            format_type,
            exc,
        )
    return "" if pd.isna(value) else str(value)


def sanitize_path_component(value, fallback="Unknown"):
    """Return a filesystem-safe path component for Windows-compatible paths."""

    text = "" if value is None or pd.isna(value) else str(value)
    text = INVALID_PATH_CHARS.sub("_", text).strip()
    text = re.sub(r"\s+", " ", text)
    return text if text else fallback


def build_contract_folder_name(contract_code, contract_name):
    """Build the limited-length contract output folder name."""

    safe_code = sanitize_path_component(contract_code)
    safe_name = sanitize_path_component(contract_name)
    folder_name = sanitize_path_component(f"{safe_code} - {safe_name}")

    if len(folder_name) <= MAX_CONTRACT_FOLDER_NAME_LENGTH:
        return folder_name

    hash_suffix = hashlib.sha1(folder_name.encode("utf-8")).hexdigest()[:8]
    suffix = f"... {hash_suffix}"
    prefix = f"{safe_code} - "
    available_name_length = MAX_CONTRACT_FOLDER_NAME_LENGTH - len(prefix) - len(suffix)

    if available_name_length > 0:
        truncated_name = safe_name[:available_name_length].rstrip(" .")
        return f"{prefix}{truncated_name}{suffix}"

    available_base_length = MAX_CONTRACT_FOLDER_NAME_LENGTH - len(suffix)
    truncated_base = folder_name[:available_base_length].rstrip(" .")
    return f"{truncated_base}{suffix}"


def clean_text_value(value):
    """Return a stripped string while tolerating blank dataframe cells."""

    if value is None or pd.isna(value):
        return ""
    return str(value).strip()


def split_contact_lines(value):
    """Normalize a fax/address cell while preserving intentional line breaks."""

    text = clean_text_value(value).replace("\r\n", "\n").replace("\r", "\n")
    return [line.strip() for line in text.split("\n") if line.strip()]


def build_contact_address_block(payer_name, attention_to, method_type, contact):
    """Build the formatted payer contact block used by AddressBlock."""

    lines = []
    payer_name = clean_text_value(payer_name)
    attention_to = clean_text_value(attention_to)
    if payer_name:
        lines.append(payer_name)
    if attention_to:
        lines.append(f"Attention To: {attention_to}")
    if clean_text_value(method_type).lower() == "fax":
        fax_number = clean_text_value(contact)
        if fax_number:
            lines.append(f"Fax: {fax_number}")
    else:
        lines.extend(split_contact_lines(contact))
    return "\n".join(lines)


class FormattedValue:
    """Wrap a raw value while deferring formatting until string coercion."""

    def __init__(self, raw, formatter, format_type="Text"):
        self.raw = raw
        self._formatter = formatter
        self.format_type = format_type

    def __str__(self):
        return self._formatter(self.raw)

    def __repr__(self):
        return f"FormattedValue(raw={self.raw!r}, formatted={str(self)!r})"

    def __float__(self):
        try:
            return float(self.raw)
        except Exception:
            return float("nan")

    def __int__(self):
        try:
            return int(float(self.raw))
        except Exception:
            return 0

    def __bool__(self):
        if pd.isna(self.raw):
            return False
        return bool(self.raw)

    def _coerce_other(self, other):
        return other.raw if isinstance(other, FormattedValue) else other

    def _is_text_comparison(self, other):
        return (
            self.format_type == "Text"
            or isinstance(other, str)
            or (
                isinstance(other, FormattedValue)
                and other.format_type == "Text"
            )
        )

    def _comparison_values(self, other):
        if self._is_text_comparison(other):
            left = str(self)
            right = str(other) if isinstance(other, FormattedValue) else str(other)
            return left, right
        return self.raw, self._coerce_other(other)

    def __eq__(self, other):
        left, right = self._comparison_values(other)
        return left == right

    def __lt__(self, other):
        left, right = self._comparison_values(other)
        return left < right

    def __le__(self, other):
        left, right = self._comparison_values(other)
        return left <= right

    def __gt__(self, other):
        left, right = self._comparison_values(other)
        return left > right

    def __ge__(self, other):
        left, right = self._comparison_values(other)
        return left >= right


def build_formatted_row(row, column_formats):
    """Return a dict of FormattedValue wrappers plus derived names."""

    data_dict = row.to_dict()
    formatted_dict = {}
    for col, val in data_dict.items():
        format_type = column_formats.get(col, "Text")
        formatted_dict[col] = FormattedValue(
            val,
            lambda raw_val, fmt=format_type: format_value(raw_val, fmt),
            format_type,
        )

    patient_name_col_key = "Patient_Name"
    first_name_placeholder = "Patient_FirstName"
    last_name_placeholder = "Patient_LastName"

    patient_value = data_dict.get(patient_name_col_key, "")
    patient_full_name = "" if pd.isna(patient_value) else str(patient_value)

    if patient_full_name and "," in patient_full_name:
        try:
            parts = patient_full_name.split(",", 1)
            formatted_dict[last_name_placeholder] = parts[0].strip()
            formatted_dict[first_name_placeholder] = parts[1].strip()
        except Exception:
            formatted_dict[last_name_placeholder] = patient_full_name
            formatted_dict[first_name_placeholder] = ""
    else:
        formatted_dict[last_name_placeholder] = patient_full_name.strip()
        formatted_dict[first_name_placeholder] = ""

    return formatted_dict
