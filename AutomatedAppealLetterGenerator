            bool(self.app_config.get("auto_detect_blurb", True))
        )
        self.auto_detect_medical_records_var = CliValue(
            bool(self.app_config.get("auto_detect_medical_records", False))
        )
        self.auto_send_notes_to_bot_var = CliValue(
            bool(self.app_config.get("auto_send_notes_to_bot", False))
        )
        self.entry_excel = CliValue(self.app_config.get("excel_path", ""))
        self.entry_output = CliValue(self.app_config.get("output_path", ""))
        self.entry_today_date = CliValue(self.today_date_str)
        self.entry_file_date = CliValue(self.file_date_str)
        self.entry_medical_records_folder = CliValue(
            self.app_config.get("medical_records_folder", "")
        )
        self.combo_blurb = CliValue(self.app_config.get("selected_blurb", "(None)"))
        self.combo_account_col = CliValue(special_cols.get("account_col", ""))
        self.combo_claim_user_group_col = CliValue(
            special_cols.get("claim_user_group_col", "")
        )
        self.combo_contract_code_col = CliValue(special_cols.get("contract_code_col", ""))
        self.combo_contract_name_col = CliValue(special_cols.get("contract_name_col", ""))
        self.combo_dos_col = CliValue(special_cols.get("dos_col", ""))
        self.progress_var = CliValue(0)
        self.progress_label_var = CliValue("Ready.")
        self.progress_bar = CliWidget()
        self.notebook = CliWidget()
        self.tab_config = None

    def print_info(self, message):
        if message:
            print(message, file=self.stdout, flush=True)

    def print_error(self, message):
        if message:
            print(message, file=self.stderr, flush=True)

    def after(self, _delay_ms, callback=None):
        if callback:
            return callback()
        return None

    def update_idletasks(self):
        return None

    def save_config(self, event=None):
        return None

    def populate_column_config_tab(self):
        return None

    def update_placeholder_list(self):
        return None

    def update_status_bar(self, message=None):
        if message:
            self.print_info(message)

    def q_print(self, message):
        self.print_info(message)

    def process_error_queue(self):
        return None

    def reset_progress(self, total, task_name):
        self.current_task_total = max(total, 0)
        self.current_task_completed = 0
        self.cancel_requested = False
        self.fatal_error = False
        self.progress_var.set(0)
        self.progress_label_var.set(f"{task_name}: 0/{total}")
        self.print_info(f"{task_name}: 0/{total}")

    def increment_progress(self, task_name):
        self.current_task_completed += 1
        self.progress_var.set(self.current_task_completed)
        self.progress_label_var.set(
            f"{task_name}: {self.current_task_completed}/{self.current_task_total}"
        )
        if (
            self.current_task_completed <= 10
            or self.current_task_completed == self.current_task_total
            or self.current_task_completed % 25 == 0
        ):
            self.print_info(self.progress_label_var.get())

    def finalize_progress(self, message):
        self.progress_label_var.set(message)
        self.print_info(message)

    def run_generate_from_cli(self):
        """Run the configured generation workflow and return a process exit code."""

        with CliMessageboxPatch(self):
            if not self.auto_detect_blurb_var.get():
                selected_blurb = self.combo_blurb.get()
                if (
                    selected_blurb
                    and selected_blurb != "(None)"
                    and selected_blurb not in self.app_config.get("blurbs", {})
                ):
                    available = ", ".join(sorted(self.app_config.get("blurbs", {})))
                    detail = f" Available rationales: {available}" if available else ""
                    self.print_error(
                        f"ERROR: Rationale not found: {selected_blurb}.{detail}"
                    )
                    return 1
            if not self.reload_excel_file(async_load=False):
                return 1
            if not self.validate_common_inputs():
                return 1
            if not self.validate_selected_rationales_before_generation():
                return 1
            self.auto_send_notes_to_bot_enabled_for_run = bool(
                self.auto_send_notes_to_bot_var.get()
            )
            self.set_buttons_state("disabled")
            try:
                self.run_generate_appeals()
            except Exception as exc:
                self.print_error(f"ERROR: Generation failed: {exc}")
                logging.error("CLI generation failed", exc_info=True)
                return 1

        generation = self.last_generation_summary
        if generation.get("failed", 0):
            return 1
        send_summary = getattr(self, "last_send_to_bot_summary", {})
        if (
            self.auto_send_notes_to_bot_enabled_for_run
            and self.last_notes_file_paths
            and send_summary
            and not send_summary.get("ok", True)
        ):
            return 1
        return 0

    def run_send_notes_from_cli(self, note_files):
        """Copy explicit notes files to the bot intake folder."""

        valid_files = []
        missing_files = []
        for file_path in note_files:
            candidate = Path(file_path)
            if candidate.exists() and candidate.is_file():
                valid_files.append(str(candidate))
            else:
                missing_files.append(str(candidate))

        for file_path in missing_files:
            self.print_error(f"ERROR: Notes file not found: {file_path}")
        if missing_files or not valid_files:
            return 1

        self.last_notes_file_paths = valid_files
        with CliMessageboxPatch(self):
            ok = self.run_send_to_bot(show_success_message=False, reset_buttons=False)
        return 0 if ok else 1


def configure_logging():
    """Initialize file logging for GUI and CLI runs."""

    logging.basicConfig(
        filename=DEBUG_LOG_PATH,
        filemode="w",
        level=logging.DEBUG,
        format="%(asctime)s - %(levelname)s - %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )
    logging.info("App Initialized")


def launch_gui():
    """Start the Tkinter GUI and return a process exit code."""

    configure_logging()
    try:
        app = MergeApp()
        app.mainloop()
        return 0
    except Exception as e:
        logging.error(f"Fatal GUI error: {e}", exc_info=True)
        import traceback
        traceback.print_exc()
        try:
            messagebox.showerror(
                "Fatal Error",
                f"A critical error occurred:\n{e}\n\nCheck app_crash.log for details.",
            )
        except Exception:
            pass
        with open(CRASH_LOG_PATH, "a", encoding="utf-8") as f:
            f.write(f"\n--- {datetime.now()} ---\n")
            f.write(traceback.format_exc())
        return 1


def build_cli_parser():
    """Create the terminal command parser."""

    parser = argparse.ArgumentParser(
        prog="AutomatedAppealLetterGenerator.py",
        description="Generate appeal letters from the terminal or open the GUI.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  python AutomatedAppealLetterGenerator.py\n"
            "  python AutomatedAppealLetterGenerator.py gui\n"
            "  python AutomatedAppealLetterGenerator.py generate --excel report.xlsx --output C:\\Appeals\n"
            "  python AutomatedAppealLetterGenerator.py generate --no-send-notes-to-bot\n"
            "  python AutomatedAppealLetterGenerator.py send-notes Notes051926120000.xlsx\n"
            "  python AutomatedAppealLetterGenerator.py config show\n"
        ),
    )
    subparsers = parser.add_subparsers(dest="command")

    gui_parser = subparsers.add_parser("gui", help="Open the desktop GUI.")
    gui_parser.set_defaults(handler=lambda _args: launch_gui())

    generate_parser = subparsers.add_parser(
        "generate",
        help="Generate appeal packets using saved config plus optional overrides.",
    )
    generate_parser.add_argument("--excel", metavar="PATH", help="Excel report to use.")
    generate_parser.add_argument("--output", metavar="PATH", help="Output folder.")
    generate_parser.add_argument(
        "--letter-date",
        metavar="TEXT",
        help='Letter date text, for example "May 19, 2026".',
    )
    generate_parser.add_argument(
        "--file-date",
        metavar="MMDDYY",
        help="Short file date used in generated filenames.",
    )
    bot_group = generate_parser.add_mutually_exclusive_group()
    bot_group.add_argument(
        "--send-notes-to-bot",
        dest="send_notes_to_bot",
        action="store_true",
        default=None,
        help="Send generated notes to the bot intake folder for this run.",
    )
    bot_group.add_argument(
        "--no-send-notes-to-bot",
        dest="send_notes_to_bot",
        action="store_false",
        help="Do not send generated notes to the bot intake folder for this run.",
    )
    med_group = generate_parser.add_mutually_exclusive_group()
    med_group.add_argument(
        "--auto-detect-medical-records",
        dest="auto_detect_medical_records",
        action="store_true",
        default=None,
        help="Move matching medical record files into generated appeal folders.",
    )
    med_group.add_argument(
        "--no-auto-detect-medical-records",
        dest="auto_detect_medical_records",
        action="store_false",
        help="Disable medical record auto-detection for this run.",
    )
    generate_parser.add_argument(
        "--medical-records-folder",
        metavar="PATH",
        help="Medical records source folder for this run.",
    )
    generate_parser.add_argument(
        "--bot-path",
        metavar="PATH",
        help="Bot intake folder for this run.",
    )
    generate_parser.add_argument(
        "--rationale",
        metavar="NAME",
        help="Use a specific saved rationale instead of RationaleName auto-detection.",
    )
    generate_parser.set_defaults(handler=run_cli_generate)

    send_parser = subparsers.add_parser(
        "send-notes",
        help="Copy explicit Notes*.xlsx files to the bot intake folder.",
    )
    send_parser.add_argument("files", nargs="+", metavar="FILE")
    send_parser.add_argument(
        "--bot-path",
        metavar="PATH",
        help="Bot intake folder for this send operation.",
    )
    send_parser.set_defaults(handler=run_cli_send_notes)

    config_parser = subparsers.add_parser(
        "config",
        help="Show or update shared GUI/CLI defaults.",
    )
    config_subparsers = config_parser.add_subparsers(
        dest="config_command",
        required=True,
    )
    config_show = config_subparsers.add_parser("show", help="Show key saved settings.")
    config_show.set_defaults(handler=run_cli_config_show)
    config_set = config_subparsers.add_parser("set", help="Update key saved settings.")
    config_set.add_argument("--output", metavar="PATH", help="Default output folder.")
    config_set.add_argument("--excel", metavar="PATH", help="Default Excel report.")
    config_set.add_argument(
        "--medical-records-folder",
        metavar="PATH",
        help="Default medical records folder.",
    )
    config_set.add_argument("--bot-path", metavar="PATH", help="Default bot intake folder.")
    config_set.add_argument(
        "--auto-detect-medical-records",
        choices=("on", "off"),
        help="Default medical-record auto-detection behavior.",
    )
    config_set.add_argument(
        "--auto-send-notes-to-bot",
        choices=("on", "off"),
        help="Default bot-send behavior after generation.",
    )
    config_set.add_argument(
        "--auto-detect-rationale",
        choices=("on", "off"),
        help="Default rationale selection behavior.",
    )
    config_set.add_argument(
        "--rationale",
        metavar="NAME",
        help="Default manual rationale name; also turns auto-detect rationale off.",
    )
    config_set.add_argument(
        "--clear-rationale",
        action="store_true",
        help="Clear the default manual rationale and reset it to (None).",
    )
    config_set.set_defaults(handler=run_cli_config_set)

    return parser


def run_cli_generate(args):
    """Handle the generate command."""

    configure_logging()
    try:
        app_config = load_saved_app_config()
    except Exception as exc:
        print(f"ERROR: Could not load config {CONFIG_FILE_PATH}: {exc}", file=sys.stderr)
        return 1

    if args.excel is not None:
        app_config["excel_path"] = args.excel
    if args.output is not None:
        app_config["output_path"] = args.output
    if args.medical_records_folder is not None:
        app_config["medical_records_folder"] = args.medical_records_folder
    if args.bot_path is not None:
        app_config["bot_network_path"] = args.bot_path
    if args.auto_detect_medical_records is not None:
        app_config["auto_detect_medical_records"] = bool(args.auto_detect_medical_records)
    if args.send_notes_to_bot is not None:
        app_config["auto_send_notes_to_bot"] = bool(args.send_notes_to_bot)
    if args.rationale is not None:
        app_config["auto_detect_blurb"] = False
        app_config["selected_blurb"] = args.rationale

    runner = HeadlessMergeRunner(app_config)
    if args.letter_date is not None:
        runner.entry_today_date.set(args.letter_date)
    if args.file_date is not None:
        runner.entry_file_date.set(args.file_date)
    return runner.run_generate_from_cli()


def run_cli_send_notes(args):
    """Handle the send-notes command."""

    configure_logging()
    try:
        app_config = load_saved_app_config()
    except Exception as exc:
        print(f"ERROR: Could not load config {CONFIG_FILE_PATH}: {exc}", file=sys.stderr)
        return 1
    if args.bot_path is not None:
