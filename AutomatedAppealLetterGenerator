    def get_blurb_payload(self, blurb_key):
        """Return the blurb body and subject for the selected key."""
        if not blurb_key or blurb_key == "(None)":
            return "", DEFAULT_BLURB_SUBJECT
        blurb_data = self.app_config["blurbs"].get(blurb_key, {})
        if isinstance(blurb_data, dict):
            return blurb_data.get("body", ""), blurb_data.get(
                "subject", DEFAULT_BLURB_SUBJECT
            )
        return str(blurb_data), DEFAULT_BLURB_SUBJECT

    def get_row_blurb_payload(self, row):
        """Resolve the blurb body/subject for a specific dataframe row."""

        if self.auto_detect_blurb_var.get():
            if "BlurbName" not in self.df.columns:
                return None, None, "Missing BlurbName column"
            blurb_key = clean_text_value(row.get("BlurbName", ""))
            if not blurb_key:
                return None, None, "Missing BlurbName value"
            if blurb_key not in self.app_config["blurbs"]:
                return None, None, f"BlurbName '{blurb_key}' does not match an existing blurb"
            blurb_body, blurb_subject = self.get_blurb_payload(blurb_key)
            return blurb_body, blurb_subject, None

        blurb_key = self.combo_blurb.get() if hasattr(self, "combo_blurb") else "(None)"
        blurb_body, blurb_subject = self.get_blurb_payload(blurb_key)
        return blurb_body, blurb_subject, None

