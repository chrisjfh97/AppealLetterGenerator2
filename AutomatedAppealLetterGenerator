        acr_frame = ttk.LabelFrame(frame, text="Claim User Group Acronyms")
        acr_frame.grid(row=1, column=0, sticky=tk.NSEW)
        acr_frame.columnconfigure(0, weight=1)
        acr_frame.rowconfigure(0, weight=1)
        self.acronym_columns = ["Claim User Group", "Acronym", "Mailing Folder"]
        self.acronym_tree = ttk.Treeview(
            acr_frame,
            columns=self.acronym_columns,
            show="headings",
            style="Bordered.Treeview",
        )
        for col in self.acronym_columns:
            self.acronym_tree.heading(col, text=col)
            width = 360 if col == "Mailing Folder" else 220
            self.acronym_tree.column(col, width=width, anchor=tk.W)
        self.apply_tree_row_borders(self.acronym_tree)
        self.acronym_tree.grid(row=0, column=0, sticky=tk.NSEW)
        acr_scroll = ttk.Scrollbar(acr_frame, orient=tk.VERTICAL, command=self.acronym_tree.yview)
        acr_scroll.grid(row=0, column=1, sticky=tk.NS)
        acr_xscroll = ttk.Scrollbar(acr_frame, orient=tk.HORIZONTAL, command=self.acronym_tree.xview)
        acr_xscroll.grid(row=1, column=0, sticky=tk.EW)
        self.acronym_tree.configure(yscrollcommand=acr_scroll.set, xscrollcommand=acr_xscroll.set)
        acr_btns = ttk.Frame(acr_frame)
        acr_btns.grid(row=2, column=0, columnspan=2, sticky=tk.EW, pady=(6, 0))
        for i in range(3):
            acr_btns.columnconfigure(i, weight=1)
        ttk.Button(acr_btns, text="Add", command=lambda: self.edit_acronym_row()).grid(row=0, column=0, sticky=tk.EW, padx=2)
        ttk.Button(acr_btns, text="Edit", command=lambda: self.edit_acronym_row(edit=True)).grid(row=0, column=1, sticky=tk.EW, padx=2)
        ttk.Button(acr_btns, text="Remove", command=self.remove_acronym_row).grid(row=0, column=2, sticky=tk.EW, padx=2)
        self.acronym_tree.bind("<Double-1>", lambda event: self.edit_acronym_row(edit=True))
        # Migrate any existing mapping rows that used the old combined "Method + Contact" columns
        rows = self.app_config.get("mapping_rows", [])
        if rows:
            migrated = False
            for r in rows:
                for i, old_col in enumerate(["1st Method + Contact (1)", "2nd Method + Contact (2)", "3rd Method + Contact (3)"], start=1):
                    if old_col in r and r.get(old_col):
                        val = str(r.get(old_col, "")).strip()
                        if " - " in val:
                            t, c = val.split(" - ", 1)
                        else:
                            # No explicit prefix; try to infer (default to contact only)
                            t, c = "", val
                        r[f"Method {i} Type"] = t.strip()
                        r[f"Method {i} Contact"] = c.strip()
                        # remove old combined field
                        if old_col in r:
                            del r[old_col]
                        migrated = True
            if migrated:
                self.app_config["mapping_rows"] = rows
                self.save_config()
        self.refresh_mapping_views()
        return frame
