def normalize_extracted_note_text(text):
    """Normalize extracted note text while preserving intentional line breaks."""

    if text is None:
        return ""
    cleaned = str(text).replace("\r\n", "\n").replace("\r", "\n")
    cleaned = re.sub(r"[ \t]+\n", "\n", cleaned)
    cleaned = re.sub(r"\n{2,}", "\n", cleaned)
    return cleaned.strip()


def normalize_note_address_text(text):
    """Collapse address/contact text to one line for note-export headings."""

    if text is None:
        return ""
    return re.sub(r"\s+", " ", str(text)).strip()


def initialize_user_directories():
    """Ensure the user's desktop contains the folders required by the app."""

    desktop_path = Path.home() / "Desktop"
    try:
        desktop_path.mkdir(parents=True, exist_ok=True)
    except Exception:
        # Fall back to storing beside the executable if the Desktop cannot be used.
        desktop_path = BASE_DIR

    app_root = desktop_path / APP_DESKTOP_FOLDER_NAME

    def ensure_directory(path: Path, description: str):
        try:
            path.mkdir(parents=True, exist_ok=True)
            return path
        except Exception as exc:
            print(f"Warning: Could not create {description} at {path}: {exc}")
            return None

    root_path = ensure_directory(app_root, "application directory")
    if root_path is None:
        print("Warning: Using application base directory for storage.")
        root_path = BASE_DIR

    created_paths = {"root": root_path}

    for folder in APP_SUBDIRECTORIES:
        if root_path == BASE_DIR:
            preferred_path = BASE_DIR / folder
        else:
            preferred_path = root_path / folder
        folder_path = ensure_directory(preferred_path, f"{folder} folder")
        if folder_path is None:
            folder_path = root_path if isinstance(root_path, Path) else BASE_DIR
        created_paths[folder] = folder_path

    return created_paths


