    def _filename_contains_exact_account(self, filename, account_number):
        """Return whether filename contains account_number as a separate token."""

        account_text = self._account_match_text(account_number)
        if not account_text:
            return False
        pattern = rf"(?<![A-Za-z0-9]){re.escape(account_text)}(?![A-Za-z0-9])"
        return re.search(pattern, filename, re.IGNORECASE) is not None

    def _account_match_text(self, account_number):
        """Normalize account numbers for exact filename matching."""

        if account_number is None or pd.isna(account_number):
            return ""
        if isinstance(account_number, float) and account_number.is_integer():
            return str(int(account_number))
        return clean_text_value(account_number)

    def move_matching_medical_records(self, claim_user_group, account_number, target_dir, filename_base):
        """Move matching medical records into the appeal folder with medrec suffixes."""

        if not self._medical_records_enabled():
            return []

        search_root = self._medical_records_search_root(claim_user_group)
        if not search_root or not search_root.exists() or not search_root.is_dir():
            return []

        matches = []
        for current_dir, _, filenames in os.walk(search_root):
            for filename in filenames:
                source = Path(current_dir) / filename
                if source.is_file() and self._filename_contains_exact_account(source.name, account_number):
                    matches.append(source)

        moved_paths = []
        destination = Path(target_dir)
        for idx, source in enumerate(sorted(matches, key=lambda path: str(path).lower())):
            suffix = ".medrec" if idx == 0 else f".medrec{idx}"
            target = destination / f"{filename_base}{suffix}{source.suffix}"
            try:
                if source.resolve() == target.resolve():
                    moved_paths.append(str(target))
                    continue
                if target.exists():
                    target.unlink()
                shutil.move(str(source), str(target))
                moved_paths.append(str(target))
            except Exception as exc:
                self.q_print(f"Medical record move warning for {account_number}: {source.name} - {exc}")
        return moved_paths

    def _copy_file_flat_overwrite(self, source_path, destination_folder):
        """Copy one file into a folder, replacing any existing same-name file."""

        source = Path(source_path)
        destination = Path(destination_folder)
        destination.mkdir(parents=True, exist_ok=True)
        target = destination / source.name
        shutil.copy2(source, target)
        return target

    def _parse_selected_method(self, mapping_row):
        method_to_use = str(mapping_row.get("MethodToUse", "")).strip()
        if method_to_use not in {"1", "2", "3"}:
            return None, None, "Invalid MethodToUse value"
        type_field = f"Method {method_to_use} Type"
        contact_field = f"Method {method_to_use} Contact"
        method_type = clean_text_value(mapping_row.get(type_field, ""))
        contact = clean_text_value(mapping_row.get(contact_field, ""))
        if not method_type:
            return None, None, "Missing method type"
        if not contact:
            return None, None, "Missing method contact"
        method_type_norm = method_type.strip().capitalize()
        if method_type_norm in {"Fax", "Mail"}:
            return method_type_norm, contact, None
        return None, None, "Invalid method type"

    def cleanup_failed_output(self, account_dir, created_paths=None):
        """Remove partial files and empty folders left by a failed row."""

        created_paths = created_paths or []
        for file_path in created_paths:
            try:
                path = Path(file_path)
                if path.exists() and path.is_file():
                    path.unlink()
            except Exception as exc:
                self.q_print(f"Cleanup warning for {file_path}: {exc}")

        try:
            output_root = Path(self.output_path).resolve()
            current = Path(account_dir).resolve()
            while current != output_root and output_root in current.parents:
                try:
                    current.rmdir()
                except OSError:
                    break
                current = current.parent
        except Exception as exc:
            self.q_print(f"Folder cleanup warning for {account_dir}: {exc}")

    def copy_mail_outputs_to_mailing_folders(self, successes):
        """Copy generated Mail files into each Claim User Group's mailing folder."""

        copied = 0
        failures = []
        for item in successes:
            if item.get("method_type") != "Mail":
                continue
            mailing_folder = clean_text_value(item.get("mailing_folder", ""))
            if not mailing_folder:
                failures.append((item.get("index"), "Missing Mailing Folder for Claim User Group"))
                continue
            for file_path in item.get("generated_paths", []):
                try:
                    if file_path and os.path.exists(file_path):
                        self._copy_file_flat_overwrite(file_path, mailing_folder)
                        copied += 1
                except Exception as exc:
                    failures.append((item.get("index"), f"Mailing folder copy failed for {Path(file_path).name}: {exc}"))
        if copied:
            self.q_print(f"Copied {copied} mailed appeal file(s) into mailing folders.")
        return failures

    def get_generation_row_groups(self):
        """Return ordered row groups keyed by Claim User Group and Contract Code."""

        rows = list(self.df.iterrows())
        grouped = {}
        for original_order, (index, row) in enumerate(rows):
            ugid = sanitize_path_component(row.get(self.claim_user_group_col, ""))
            contract_code = sanitize_path_component(row.get(self.contract_code_col, ""))
            grouped.setdefault((ugid, contract_code), []).append((original_order, index, row))

        ordered_groups = []
        for group_key in sorted(grouped, key=lambda key: (key[0].lower(), key[1].lower())):
            group_rows = sorted(grouped[group_key], key=lambda item: item[0])
            ordered_groups.append((group_key, [(index, row) for _, index, row in group_rows]))
        return ordered_groups

    def extract_notes_from_successes(self, successes):
        """Automatically build notes files after generation for successful rows."""
        # Group extracted notes by the "day" folder (two levels up from the letter file)
        start_text = self.app_config["extract_config"].get("start", DEFAULT_EXTRACT_START)
        end_text = self.app_config["extract_config"].get("end", DEFAULT_EXTRACT_END)
        pattern = rf"({re.escape(start_text)}.*?)(?={re.escape(end_text)})" if end_text else rf"({re.escape(start_text)}.*)"

        day_rows = {}  # key: day_folder_str -> list of rows
        fax_ready_files = {}  # key: day_folder_str -> set of fax filenames

        for item in successes:
            try:
                doc = Document(item["letter_path"])
                letter_text = "\n".join([para.text for para in doc.paragraphs])
                match = re.search(pattern, letter_text, re.DOTALL | re.IGNORECASE)
                extracted_text = normalize_extracted_note_text(match.group(1)) if match else ""
                if item["method_type"] == "Mail":
                    address = normalize_note_address_text(item["address_block"])
                    heading = f"Appeal letter mailed to {item['payer_name']}, address: {address}. Noted as:"
                    status = "2003"
                else:
                    attn_text = f", attention to: {item['payer_attn']}" if item.get("payer_attn") else ""
                    heading = f"Appeal letter faxed to {item['payer_name']}{attn_text}, fax number: {item.get('payer_fax', '')}. Noted as:"
                    status = "2004"

                saved_as = Path(item['letter_path']).stem
                row_entry = [
                    item.get('account', ''),
                    f"{heading}\n{extracted_text}\nSaved as: {saved_as}",
                    item.get('ugid', ''),
                    status,
                    item.get('workflow_reason', ''),
                    item.get('dos', ''),
                ]

                # Day folder is two levels up from the letter file (Account -> Day)
                try:
                    day_folder = Path(item['letter_path']).parent.parent
                except Exception:
                    day_folder = Path(self.output_path)

                day_folder_str = str(day_folder)
                day_rows.setdefault(day_folder_str, []).append(row_entry)

                # Track fax filenames for Ready.txt
                if item.get('method_type') == 'Fax':
                    if item.get('fax_path'):
                        fax_name = Path(item['fax_path']).name
                    else:
                        fax_name = f"{Path(item['letter_path']).stem}.fax.docx"
                    fax_ready_files.setdefault(day_folder_str, set()).add(fax_name)

            except Exception as exc:
                self.q_print(f"Note extraction warning for {item.get('account')}: {exc}")

        # Write one notes file into each day folder after all generated letters are available.
        self.last_notes_file_paths = []
        used_note_filenames = set()
        for day_folder_str, rows in day_rows.items():
            if not rows:
                continue
            day_folder = Path(day_folder_str)
            while True:
                timestamp = datetime.now().strftime("%m%d%y%H%M%S")
                notes_filename = f"Notes{timestamp}.xlsx"
                notes_path = day_folder / notes_filename
                if notes_filename not in used_note_filenames and not notes_path.exists():
                    used_note_filenames.add(notes_filename)
                    break
                time.sleep(0.2)
            try:
                df_notes = pd.DataFrame(rows, columns=["Reference", "Note", "UGID", "Status Message", "Workflow Reason", "DOS"])
                df_notes.to_excel(notes_path, index=False, sheet_name="Notes")
                self._add_notes_table(notes_path)
                self.last_notes_file_paths.append(str(notes_path))
            except Exception as exc:
                self.q_print(f"Failed to write notes file {notes_path}: {exc}")

        # For faxed letters, create or append a Ready.txt in the day folder listing fax files
        for day_folder_str, fax_names in fax_ready_files.items():
            try:
                ready_path = Path(day_folder_str) / "Ready.txt"
                # Create a simple Ready marker file only if it doesn't already exist
                if not ready_path.exists():
                    try:
                        ready_path.write_text("Ready\n", encoding='utf-8')
                    except Exception as exc:
                        self.q_print(f"Failed to write Ready.txt in {day_folder_str}: {exc}")
            except Exception as exc:
                self.q_print(f"Failed to write Ready.txt in {day_folder_str}: {exc}")

        if self.last_notes_file_paths and hasattr(self, "btn_send_to_bot"):
            self.btn_send_to_bot.config(state=tk.NORMAL)

