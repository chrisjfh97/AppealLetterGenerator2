class CliMessageboxPatch:
    """Route Tk messagebox calls to the terminal while running headlessly."""

    def __init__(self, runner):
        self.runner = runner
        self.originals = {}

    def __enter__(self):
        for name in ("showerror", "showwarning", "showinfo", "askyesno"):
            self.originals[name] = getattr(messagebox, name)
        messagebox.showerror = self.showerror
        messagebox.showwarning = self.showwarning
        messagebox.showinfo = self.showinfo
        messagebox.askyesno = self.askyesno
        return self

    def __exit__(self, *_exc_info):
        for name, original in self.originals.items():
            setattr(messagebox, name, original)

    def showerror(self, title, message, *_args, **_kwargs):
        self.runner.print_error(f"ERROR: {title}: {message}")

    def showwarning(self, title, message, *_args, **_kwargs):
        self.runner.print_error(f"WARNING: {title}: {message}")

    def showinfo(self, title, message, *_args, **_kwargs):
        self.runner.print_info(f"{title}: {message}")

    def askyesno(self, title, message, *_args, **_kwargs):
        self.runner.print_error(f"Prompt skipped in CLI: {title}: {message}")
        return False


